@page "/Designations"
@using TMS.Shared.Model.Setup
@using TMS.Shared.Model.Filters
@using TMS.ClientServices
@using TMS.Components
@using TMS.Shared.Pagination
@using System.Timers



@inject IDesignationsClientService designationService;
@inject IJSRuntime JS

<div class="content-wrapper container-xxl-fluid p-0">
   
    <div class="content-body">
        <!-- users list start -->
        <section class="app-designations-list">
            <div class="row">
                <div class="col-lg-4 col-sm-6 " style="cursor: pointer;" @onclick="@(() => FilterDepartments(""))">
                    <div class="card @(filter.IsActive == "" ? "border-success" : "")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@designationsummary.TotalDesignations</h3>
                                <span>Total Designations</span>
                            </div>
                            <div class="avatar bg-light-primary p-50">
                                <span class="avatar-content">
                                    <i data-feather="layers" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterDepartments("Active"))">
                    <div class="card @(filter.IsActive == "Active" ? "border-success" : "")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@designationsummary.TotalActiveDesignations</h3>
                                <span>Active Designations</span>
                            </div>
                            <div class="avatar bg-light-success p-50">
                                <span class="avatar-content">
                                    <i data-feather="activity" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterDepartments("InActive"))">
                    <div class="card @(filter.IsActive == "InActive" ? "border-success" : "")" >
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@designationsummary.TotalInActiveDesignations</h3>
                                <span>InActive Designations</span>
                            </div>
                            <div class="avatar bg-light-danger p-50">
                                <span class="avatar-content">
                                    <i data-feather="pause-circle" class="font-medium-4"></i>
                                </span>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <!-- list and filter start -->
            <div class="card">

                <div class="card-body">

                    <!-- Top Toolbar -->
                    <div class="row align-items-center g-2 mb-3">

                        <!-- Left -->
                        <div class="col-md-3">

                            <h4 class="card-title mb-0">Search & Filter</h4>
                        </div>

                        <!-- Right -->
                        <div class="col-md-9">

                            <div class="d-flex justify-content-end gap-2">

                                <div class="d-flex align-items-center">
                                    <label class="me-2">Search:</label>
                                    <input class="form-control form-control-sm"
                                           style="width:200px;"
                                           placeholder="Search..." @oninput="HandleInput" />
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        <i data-feather="share"></i>
                                        Export
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                        <li><a class="dropdown-item" href="#">Excel</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>

                                    </ul>
                                </div>

                                <button class="btn btn-primary" @onclick="OpenModel">
                                    Add New Designation
                                </button>

                            </div>

                        </div>

                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <div class="mt-1 fw-bold">
                                Loading Designations...
                            </div>
                        </div>
                    }
                    else
                    {


                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Designation Id</th>
                                        <th>Designation Name</th>
                                        <th>STATUS</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (designationList.Data == null)
                                    {
                                        <tr><td colspan="6" class="text-center py-5">No users found.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var designation in designationList.Data)
                                        {
                                            <tr>
                                               
                                                <td><span>@designation.Id</span></td>
                                                <td><span>@designation.DesignationName</span></td>
                                                <td>
                                                    <span>
                                                        <span class="badge @(designation.IsActive == true ? "bg-success" : "bg-danger")">
                                                            @(designation.IsActive == true ? "Active" : "InActive")
                                                    </span></span></td>
                                                <td>
                                                    <button class="btn btn-sm btn-icon btn-outline-primary" @onclick="() => EditDesignation(designation.Id)">
                                                        <i data-feather="edit" class="font-medium-3"></i>
                                                    </button>
                                                </td>
                                                
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    
                </div>
            </div>
            <!-- list and filter end -->
        </section>
        <!-- users list ends -->
        
    </div>
</div>


<ModalPopup Title="Designation Details" @bind-IsVisible="isModalOpen">
    <EditForm Model="@designationDto" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="col-md-12 mb-1">
                <label class="form-label">Department Name<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="designationDto.DesignationName" />
                <ValidationMessage For="@(() => designationDto.DesignationName)" />
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-check form-switch">
                    <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="designationDto.IsActive" />
                    <label class="form-check-label" for="isActiveCheck">Is Active</label>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">
                @(designationDto.Id > 0 ? "Update" : "Save")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => isModalOpen = false">Cancel</button>
        </div>
    </EditForm>
</ModalPopup>

<ToastMessage @ref="toastRef" />

@code {

    public FilterModel filter { get; set; } = new();

    public PaginationResponse<SetupDesignationDto> designationList = new();
    public SetupDesignationDto designationDto { get; set; } = new();
    public vwDesignationSummaryDataDto designationsummary = new();
    private int currentPage = 1;
    private int pageSize = 10;

    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            designationList = await designationService.GetAllDesignationsAsync(filter);
            designationsummary = await designationService.GetDesignationSummaryDataAsync();
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error fetching users: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadData();
    }

    private async Task OpenModel()
    {
        try
        {
            isModalOpen = true;
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }


    private async Task EditDesignation(int id)
    {
        try
        {
            var found = await designationService.GetDesignationByIdAsync(id);
            if (found == null)
            {
                toastRef.Show("User not Found.", "error");
                isModalOpen = false;
            }
         
            designationDto.Id = found.Id;
            designationDto.DesignationName = found.DesignationName;
            designationDto.IsActive = found.IsActive;

            isModalOpen = true;

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }


    }

    private async Task Save()
    {
        try
        {
            int result;

            if (designationDto.Id > 0)
            {
                result = await designationService.UpdateDesignationAsync(designationDto);
            }
            else
            {
                result = await designationService.SaveDesignationAsync(designationDto);

            }
            if (result == 1)
            {
                toastRef.Show("Designation saved successfully!", "success");

                await LoadData();
                isModalOpen = false;
                designationDto = new();
            }
            else if(result == -1)
            {
                toastRef.Show("Designation Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");

        }
    }


    private void HandleInput(ChangeEventArgs e)
    {
        filter.QueryString = e.Value?.ToString();

        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (s, e) => await Search();
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task Search()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                filter.PageNumber = 1;
                currentPage = 1;

                designationList = await designationService.GetAllDesignationsAsync(filter);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
    }

    private async Task FilterDepartments(string type)
    {
        try
        {
            filter.IsActive = type;

            designationList = await designationService.GetAllDesignationsAsync(filter);
            StateHasChanged();

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }
}