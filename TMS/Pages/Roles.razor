<ToastMessage @ref="toastRef" />
@code {
    private ToastMessage toastRef { get; set; } = new();
    private List<AppScreenDto> screenList = new();
    private AppRoleDto appRoleDto = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            screenList = await screenService.GetAllScreensListAsync();
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {

    }

    public void OpenForAdd()
    {
        appRoleDto = new AppRoleDto(); // Khali object
        //InitializeEmptyPermissions();
        StateHasChanged();
    }

    // --- 3. Open Modal for EDIT (API se data fetch karega) ---
    public async Task OpenForEdit(long roleId)
    {
        try
        {
            // Server se specific role ka data mangwayein
            // var result = await Http.GetFromJsonAsync<AppRoleDto>($"api/roles/{roleId}");
            // if (result != null)
            // {
            //     appRoleDto = result;
            // }

            // SyncScreenPermissions();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading role for edit: {ex.Message}");
        }
    }

    private void InitializeEmptyPermissions()
    {
        appRoleDto.Permissions = screenList.Select(s => new AppRolesScreenDto
        {
            ScreenId = s.Id,
            CanView = false,
            CanAdd = false,
            CanEdit = false,
            CanDelete = false
        }).ToList();
    }

    private void SyncScreenPermissions()
    {
        foreach (var screen in screenList)
        {
            var exists = appRoleDto.Permissions.Any(p => p.ScreenId == screen.Id);
            if (!exists)
            {
                appRoleDto.Permissions.Add(new AppRolesScreenDto
                {
                    ScreenId = screen.Id,
                    CanView = false,
                    CanAdd = false,
                    CanEdit = false,
                    CanDelete = false
                });
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            var result = await rolesService.SaveOrUpdate(appRoleDto);
            if (result == 1)
            {
                toastRef.Show("User saved successfully!", "success");

                await LoadData();
                appRoleDto = new();
            }
            else if (result == -1)
            {
                toastRef.Show("User Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error saving role: {ex.Message}", "error");
        }
    }
}