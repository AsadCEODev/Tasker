@page "/RolesPage"
@using TMS.ClientServices
@using TMS.Shared.Model
@using TMS.Shared.Model.Filters
@using TMS.Components

@inject IAppScreenClientService screenService;
@inject IAppRolesClientService rolesService;

<!-- BEGIN: Content-->
<div class=" ">
    <div class="content-overlay"></div>
    <div class="header-navbar-shadow"></div>
    <div class="content-wrapper p-0">
        <div class="content-header row">
        </div>
        <div class="content-body">

            <!-- Top Header Bar with Title, Search Bar, and Add Button -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-4">
                    <h3 class="mb-0">App Roles List</h3>
                </div>
                <div class="col-md-8 d-flex justify-content-md-end justify-content-start mt-1 mt-md-0 gap-1">
                    <!-- Search Bar -->
                    <div class="input-group" style="max-width: 300px;">
                        <input type="text"
                               class="form-control"
                               placeholder="Search Role..."
                               @bind="filters.QueryString" @oninput="OnSearchInput" />
                        <span class="input-group-text"><i data-feather="search"></i></span>
                    </div>

                    <!-- Add New Role Button -->
                    <button class="btn btn-primary text-now0raw"
                            data-bs-target="#addRoleModal"
                            data-bs-toggle="modal"
                            @onclick="OpenForAdd">
                        <i data-feather="plus" class="me-25"></i> Add New Role
                    </button>
                </div>
            </div>

            <!-- Role cards -->
            <div class="row">
                @if (rolePermissionsList != null && rolePermissionsList.Any())
                {
                    @foreach (var role in rolePermissionsList)
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6 mb-2">
                            <div class="card h-80">
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div>
                                        <!-- Top -->
                                        <div class="d-flex justify-content-between align-items-center">
                                            <!-- Total Users -->
                                            <span class="text-muted font-small-3">
                                                @if (role.Permissions != null && role.Permissions.Any())
                                                {
                                                    @:Total @role.Permissions.Count users
                                                }
                                                else
                                                {
                                                    @:No User Assigned
                                                }
                                            </span>

                                            <!-- Avatar -->
                                            @if (role.Permissions != null && role.Permissions.Any())
                                            {
                                                <div class="avatar avatar-sm">
                                                    <img src="../../../app-assets/images/avatars/2.png"
                                                         alt="User Avatar"
                                                         class="rounded-circle" />
                                                </div>
                                            }
                                        </div>

                                        <!-- Role Information -->
                                        <div class="d-flex align-items-center mt-2 pt-25">
                                            <!-- Shield -->
                                            <div class="avatar avatar-xl bg-light-primary rounded me-1">
                                                <div class="avatar-content">
                                                    <i data-feather="shield"
                                                       class="font-large-1 text-primary">
                                                    </i>
                                                </div>
                                            </div>

                                            <!-- Role Name + Description -->
                                            <div class="role-heading">
                                                <h4 class="fw-bolder mb-50">
                                                    @role.RoleName
                                                </h4>
                                                <p class="mb-0 text-muted font-small-3">
                                                    @if (role.RoleName?.ToLower() == "admin")
                                                    {
                                                        @:System administrator with full access to all features and settings.
                                                    }
                                                    else
                                                    {
                                                        @:Role assigned with specific access to system features and settings.
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <!-- Divider -->
                                        <hr class="my-1" />

                                        <!-- Actions -->
                                        <div class="d-flex justify-content-between align-items-center">
                                            <!-- Left Actions -->
                                            <div class="d-flex align-items-center gap-1">
                                                <!-- Edit -->
                                                <a href="javascript:;"
                                                   class="d-flex align-items-center gap-50 rounded p-1 bg-light-primary text-primary role-edit-modal"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#addRoleModal"
                                                   title="Edit Role"
                                                   @onclick="() => OpenForEdit(role.Id)">
                                                    <i data-feather="edit-2"></i>
                                                </a>

                                                <!-- Delete -->
                                                <a href="javascript:;"
                                                   class="d-flex align-items-center gap-50 rounded p-1 bg-light-danger text-danger"
                                                   title="Delete Role"
                                                   @onclick="() => DeleteRole(role.Id)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>

                                            <a href="javascript:;"
                                               class="text-body"
                                               title="Copy Role">
                                                <i data-feather="copy"
                                                   class="font-medium-5">
                                                </i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-3">
                        <p class="text-muted">No roles found matching your search.</p>
                    </div>
                }
            </div>
            <!--/ Role cards -->
            <!-- Modal -->
            <div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-add-new-role">
                    <div class="modal-content">
                        <div class="modal-header bg-transparent">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-3 ">
                            <div class="text-center mb-1">
                                <h1 class="role-title">@(appRoleDto.Id == 0 ? "Add New Role" : "Edit Role")</h1>
                                <p>Set role permissions</p>
                            </div>

                            <form id="addRoleForm" class="row" @onsubmit="HandleSubmit">
                                <div class="col-12 mb-3">
                                    <label class="form-label text-muted" for="modalRoleName">Role Name</label>
                                    <input type="text" name="modalRoleName" class="form-control" placeholder="Enter Role Name" @bind="appRoleDto.RoleName" required />
                                </div>

                                <div class="col-12">
                                    <h4 class="pt-30">Role Permissions</h4>
                                    <div class="table-responsive">
                                        <table class="table table-flush-spacing">
                                            <tbody>
                                                @if (screenList != null && screenList.Any())
                                                {
                                                    @foreach (var screen in screenList)
                                                    {
                                                        var permission = appRoleDto.Permissions.FirstOrDefault(p => p.ScreenId == screen.Id);
                                                        if (permission == null)
                                                        {
                                                            permission = new AppRolesScreenDto { ScreenId = screen.Id };
                                                            appRoleDto.Permissions.Add(permission);
                                                        }

                                                        <tr>
                                                            <td class="text-nowrap text-muted align-middle">@screen.ScreenName</td>
                                                            <td class="align-middle">
                                                                <div class="d-flex align-items-center flex-nowrap overflow-x-auto py-1">
                                                                    <div class="form-check form-switch me-3 flex-shrink-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="permission.CanView" />
                                                                        <label class="form-check-label">Read</label>
                                                                    </div>
                                                                    <div class="form-check form-switch me-3 flex-shrink-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="permission.CanAdd" />
                                                                        <label class="form-check-label">Add</label>
                                                                    </div>
                                                                    <div class="form-check form-switch me-3 flex-shrink-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="permission.CanEdit" />
                                                                        <label class="form-check-label">Edit</label>
                                                                    </div>
                                                                    <div class="form-check form-switch me-3 flex-shrink-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="permission.CanDelete" />
                                                                        <label class="form-check-label">Delete</label>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="2" class="text-center text-muted">Loading permissions...</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="col-12 text-center mt-2">
                                    <button type="submit" class="btn btn-primary me-1">@(appRoleDto.Id == 0 ? "Submit" : "Update")</button>
                                    <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal" aria-label="Close">
                                        Discard
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- END: Content-->

<ToastMessage @ref="toastRef" />

@code {
    private ToastMessage toastRef { get; set; } = new();
    private List<AppScreenDto> screenList = new();
    private List<AppRoleDto> rolePermissionsList = new();
    private AppRoleDto appRoleDto = new();
    private FilterModel filters { get; set; } = new();
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            screenList = await screenService.GetAllScreensListAsync();
            rolePermissionsList = await rolesService.GetAll(filters);
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    public void OpenForAdd()
    {
        appRoleDto = new AppRoleDto();
        StateHasChanged();
    }

    public async Task OpenForEdit(long roleId)
    {
        try
        {
            var result = await rolesService.GetById(roleId);
            if (result != null)
            {
                appRoleDto = result;
            }

            SyncScreenPermissions();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading role for edit: {ex.Message}");
        }
    }

    public async Task DeleteRole(long roleId)
    {
        try
        {
            var result = await rolesService.DeleteAsync(roleId);
            if (result)
            {
                toastRef.Show("Role Deleted successfully!", "success");
                await LoadData();
            }
            else
            {
                toastRef.Show("Failed to Delete.", "error");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading role for edit: {ex.Message}");
        }
    }

    private void SyncScreenPermissions()
    {
        foreach (var screen in screenList)
        {
            var exists = appRoleDto.Permissions.Any(p => p.ScreenId == screen.Id);
            if (!exists)
            {
                appRoleDto.Permissions.Add(new AppRolesScreenDto
                {
                    ScreenId = screen.Id,
                    CanView = false,
                    CanAdd = false,
                    CanEdit = false,
                    CanDelete = false
                });
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            var result = await rolesService.SaveOrUpdate(appRoleDto);
            if (result == 1)
            {
                toastRef.Show("Saved successfully!", "success");
                await LoadData();
                appRoleDto = new();
            }
            else if (result == -1)
            {
                toastRef.Show("Role Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Failed to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error saving role: {ex.Message}", "error");
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        filters.QueryString = e.Value?.ToString();

        debounceTimer?.Dispose();

        debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}