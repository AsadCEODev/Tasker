@page "/Departments"
@using TMS.Shared.Model.Setup
@using TMS.Shared.Model.Filters
@using TMS.ClientServices
@using TMS.Components
@using TMS.Shared.Pagination
@using System.Timers



@inject IDepartmentsClientService departmentService;
@inject IJSRuntime JS

<div class="content-wrapper container-xxl-fluid p-0">
    <div class="content-header row">
    </div>
    <div class="content-body">
        <!-- Desinations list start -->
        <section class="app-departments-list">
            <div class="row">
                <div class="col-lg-4 col-sm-6 " style="cursor: pointer;" @onclick="@(() => FilterDepartments(""))">
                    <div class="card @(filter.IsActive == "" ? "border-success" : "")" >
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@departmentSummary.TotalDepartments</h3>
                                <span>Total Departments</span>
                            </div>
                            <div class="avatar bg-light-primary p-50">
                                <span class="avatar-content">
                                    <i data-feather="layers" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterDepartments("Active"))">
                    <div class="card @(filter.IsActive == "Active" ? "border-success" : "" )">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@departmentSummary.TotalActiveDepartments</h3>
                                <span>Active Departments</span>
                            </div>
                            <div class="avatar bg-light-success p-50">
                                <span class="avatar-content">
                                    <i data-feather="activity" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterDepartments("InActive"))">
                    <div class="card @(filter.IsActive == "InActive" ? "border-success" : "")" ">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@departmentSummary.TotalInActiveDepartments</h3>
                                <span>InActive Departments</span>
                            </div>
                            <div class="avatar bg-light-danger p-50">
                                <span class="avatar-content">
                                    <i data-feather="pause-circle" class="font-medium-4"></i>
                                </span>
                            </div>
                            
                        </div>
                    </div>
                </div>
                
            </div>
            <!-- list and filter start -->
            <div class="card">

                <div class="card-body">

                    <!-- Top Toolbar -->
                    <div class="row align-items-center g-2 mb-3">

                        <!-- Left -->
                        <div class="col-md-3">

                            <h4 class="card-title mb-0">Search & Filter</h4>
                        </div>

                        <!-- Right -->
                        <div class="col-md-9">

                            <div class="d-flex justify-content-end gap-2">

                                <div class="d-flex align-items-center">
                                    <label class="me-2">Search:</label>
                                    <input class="form-control form-control-sm"
                                           style="width:200px;"
                                           placeholder="Search..." @oninput="HandleInput" />
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        <i data-feather="share"></i>
                                        Export
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                        <li><a class="dropdown-item" href="#">Excel</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>

                                    </ul>
                                </div>

                                 <button class="btn btn-primary" @onclick="OpenModel">
                                    Add New Department
                                </button>

                            </div>

                        </div>

                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <div class="mt-1 fw-bold">
                                Loading Departments...
                            </div>
                        </div>
                    }
                    else
                    {


                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Department Id</th>
                                        <th>Department Name</th>
                                        <th>STATUS</th>
                                        <th>ACTIONS</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (departmentsList.Data == null)
                                    {
                                        <tr><td colspan="6" class="text-center py-5">No users found.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var department in departmentsList.Data)
                                        {
                                            <tr>
                                               
                                                <td><span>@department.Id</span></td>
                                                <td><span>@department.DepartmentName</span></td>
                                                
                                                <td><span><span class="badge @(department.IsActive == true ? "bg-success" : "bg-danger")">
                                                            @(department.IsActive == true ? "Active" : "InActive")
                                                    </span></span></td>
                                                <td>
                                                    <button class="btn btn-sm btn-icon btn-outline-primary" @onclick="() => EditDepartment(department.Id)">
                                                        <i data-feather="edit" class="font-medium-3"></i>
                                                    </button>
                                                </td>
                                                
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <!-- Pagination Footer Bar (Fixed at bottom inside the list layout) -->
                    <div class="d-flex justify-content-between align-items-center mb-2 px-3 py-2 border-top bg-white flex-shrink-0">
                        @if (departmentsList.Data != null && departmentsList.TotalCount > 0)
                        {
                            <span class="text-muted small">
                                Showing page @departmentsList.PageIndex of @departmentsList.TotalPages (Total: @departmentsList.TotalCount)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">No records to display</span>
                        }

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <!-- Previous Button -->
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <button class="page-link" type="button" @onclick="() => OnPageChanged(currentPage - 1)" disabled="@(currentPage <= 1)">‹</button>
                                </li>

                                <!-- Page Numbers -->
                                @if (departmentsList.Data != null && departmentsList.TotalPages > 0)
                                {
                                    @for (int i = 1; i <= departmentsList.TotalPages; i++)
                                    {
                                        int pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <button class="page-link" type="button" @onclick="() => OnPageChanged(pageNum)">@pageNum</button>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(departmentsList.Data == null || currentPage >= departmentsList.TotalPages ? "disabled" : "")">
                                    <button class="page-link" type="button" @onclick="() => OnPageChanged(currentPage + 1)" disabled="@(departmentsList.Data == null || currentPage >= departmentsList.TotalPages)">›</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    <!-- Pagination footer ends -->
                </div>
            </div>
            <!-- list and filter end -->
        </section>
        
        
    </div>
</div>
 
<ModalPopup Title="Department Details" @bind-IsVisible="isModalOpen">
    <EditForm Model="@departmentDto" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="col-md-12 mb-1">
                <label class="form-label">Department Name<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="departmentDto.DepartmentName"  />
                <ValidationMessage For="@(() => departmentDto.DepartmentName)" />
            </div>
            
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch">
                    <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="departmentDto.IsActive" />
                    <label class="form-check-label" for="isActiveCheck">Is Active</label>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">
                @(departmentDto.Id > 0 ? "Update" : "Save")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => isModalOpen = false">Cancel</button>
        </div>
    </EditForm>
</ModalPopup>
 
<ToastMessage @ref="toastRef" />

@code {
    public PaginationResponse<SetupDepartmentDto> departmentsList = new();
    private int currentPage = 1;
    private int pageSize = 10;

    public FilterModel filter { get; set; } = new();
    public SetupDepartmentDto departmentDto { get; set; } = new();
    public vwDepartmentSummaryDataDto? departmentSummary { get; set; } = new();
    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private bool isDisabled = false;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            departmentSummary = await departmentService.GetDepartmentSummaryDataAsync();
            departmentsList = await departmentService.GetAllDepartmentsAsync(filter);

        }
        catch (Exception ex)
        {
            toastRef.Show($"Error fetching users: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        filter.PageNumber = newPage;
        await LoadData();
    }

    private async Task OpenModel()
    {
        try
        {
            departmentDto = new();
            isDisabled = false;
            isModalOpen = true;
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }


    private async Task EditDepartment(int id)
    {
        try
        {
            var found = await departmentService.GetDepartmentByIdAsync(id);
            if (found == null)
            {
                toastRef.Show("User not Found.", "error");
                isModalOpen = false;
            }
            isDisabled = true;
            departmentDto.Id = found.Id;
            departmentDto.DepartmentName = found.DepartmentName;
            departmentDto.IsActive = found.IsActive;

            isModalOpen = true;

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }


    }

    private async Task Save()
    {
        try
        {
            int result;

            if(departmentDto.Id > 0)
            {
                result = await departmentService.UpdateDepartmentAsync(departmentDto);
            }
            else
            {
                result = await departmentService.SaveDepartmentAsync(departmentDto);

            }
            if (result == 1)
            {
                toastRef.Show("Department saved successfully!", "success");

                await LoadData();
                isModalOpen = false;
                departmentDto = new();
            }
            else if(result == -1)
            {
                toastRef.Show("Department Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");

        }
    }


    private void HandleInput(ChangeEventArgs e)
    {
        filter.QueryString = e.Value?.ToString();

        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (s, e) => await Search();
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task Search()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                filter.PageNumber = 1;
                currentPage = 1;  

                departmentsList = await departmentService.GetAllDepartmentsAsync(filter);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
    }


    private async Task FilterDepartments(string type)
    {
        try
        {
            filter.IsActive = type;
            departmentsList = await departmentService.GetAllDepartmentsAsync(filter);
             StateHasChanged();

        }
        catch(Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }
}