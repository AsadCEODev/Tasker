@page "/userpage"
@using TMS.Shared.Model.Setup
@using TMS.Shared.Model.Filters
@using TMS.ClientServices
@using TMS.Components
@using TMS.Shared.Pagination
@using System.Timers



@inject IUserClientService userService;
@inject IDepartmentsClientService departmentService;
@inject IDesignationsClientService designationService;
@inject IJSRuntime JS

<div class="content-wrapper container-xxl-fluid p-0">
    <div class="content-header row">
    </div>
    <div class="content-body">
        <!-- users list start -->
        <section class="app-user-list">
            <div class="row">
                <!-- Total Users Card -->
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterUsers(""))">
                    <div class="card @(string.IsNullOrEmpty(filters.IsActive) ? "border-success" : "")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.TotalUserCount</h3>
                                <span>Total Users</span>
                            </div>
                            <div class="avatar bg-light-primary p-50">
                                <span class="avatar-content">
                                    <i data-feather="user" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Users Card -->
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterUsers("Active"))">
                    <div class="card @(filters.IsActive == "Active" ? "border-success" : "")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.ActiveUserCount</h3>
                                <span>Active Users</span>
                            </div>
                            <div class="avatar bg-light-success p-50">
                                <span class="avatar-content">
                                    <i data-feather="user-check" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- InActive Users Card -->
                <div class="col-lg-4 col-sm-6" style="cursor: pointer;" @onclick="@(() => FilterUsers("InActive"))">
                    <div class="card @(filters.IsActive == "InActive" ? "border-success" : "")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.InactiveUserCount</h3>
                                <span>InActive Users</span>
                            </div>
                            <div class="avatar bg-light-danger p-50">
                                <span class="avatar-content">
                                    <i data-feather="user-x" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
            <!-- list and filter start -->
            <div class="card">

                <div class="card-body">

                    <!-- Top Toolbar -->
                    <div class="row align-items-center g-2 mb-3">

                        <!-- Left -->
                        <div class="col-md-3">

                            <h4 class="card-title mb-0">Search & Filter</h4>
                        </div>

                        <!-- Right -->
                        <div class="col-md-9">

                            <div class="d-flex justify-content-end gap-2">

                                <div class="d-flex align-items-center">
                                    <label class="me-2">Search:</label>
                                    <input class="form-control form-control-sm"
                                           style="width:200px;"
                                           placeholder="Search..." @oninput="HandleInput" />
                                </div>

                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        <i data-feather="share"></i>
                                        Export
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                        <li><a class="dropdown-item" href="#">Excel</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>

                                    </ul>
                                </div>

                                <button class="btn btn-primary" @onclick="OpenModel">
                                    Add New User
                                </button>
                           
                            </div>

                        </div>

                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <div class="mt-1 fw-bold">
                                Loading users...
                            </div>
                        </div>
                    }
                    else
                    {


                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th @onclick='() => SortTable("Id")' role="button">
                                            Id @GetSortIcon("Id")
                                        </th>
                                        <th @onclick='() => SortTable("UserName")' role="button">
                                            User Name @GetSortIcon("UserName")
                                        </th>
                                        <th @onclick='() => SortTable("FullName")' role="button">
                                            Full Name @GetSortIcon("FullName")
                                        </th>
                                        <th @onclick='() => SortTable("FatherName")' role="button">
                                            Father Name @GetSortIcon("FatherName")
                                        </th>
                                        <th @onclick='() => SortTable("Email")' role="button">
                                            Email @GetSortIcon("Email")
                                        </th>
                                        <th @onclick='() => SortTable("PhoneNo")' role="button">
                                            Phone No @GetSortIcon("PhoneNo")
                                        </th>
                                        <th @onclick='() => SortTable("IsActive")' role="button">
                                            STATUS @GetSortIcon("IsActive")
                                        </th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pagedResult.Data == null || !pagedResult.Data.Any())
                                    {
                                        <tr><td colspan="6" class="text-center py-5">No users found.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var user in pagedResult.Data)
                                        {
                                            <tr>
                                                <td><span>@user.Id</span></td>
                                                <td><span>@user.UserName</span></td>
                                                <td><span>@user.FullName</span></td>
                                                <td><span>@user.FatherName</span></td>
                                                <td><span>@user.Email</span></td>
                                                <td><span>@user.PhoneNo</span></td>
                                                <td>
                                                    <span class="badge @(user.IsActive == true ? "bg-success" : "bg-danger")">
                                                        @(user.IsActive == true ? "Active" : "InActive")
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-icon btn-outline-primary" @onclick="() => EditUser(user.Id)">
                                                        <i data-feather="edit" class="font-medium-3"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <!-- Footer -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        @if (pagedResult != null && pagedResult.TotalCount > 0)
                        {

                            <span class="text-muted">
                                Showing page @pagedResult.PageIndex of @pagedResult.TotalPages
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No records to display</span>
                        }

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <!-- Previous Button -->
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage - 1)">‹</a>
                                </li>

                                <!-- Page Numbers -->
                                @if (pagedResult != null && pagedResult.TotalPages > 0)
                                {
                                    @for (int i = 1; i <= pagedResult.TotalPages; i++)
                                    {
                                        int pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <a class="page-link" @onclick="() => OnPageChanged(pageNum)">@pageNum</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(pagedResult == null || currentPage >= pagedResult.TotalPages ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage + 1)">›</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <!-- list and filter end -->
        </section>
        <!-- users list ends -->

    </div>
</div>


<ModalPopup Title="User Details" @bind-IsVisible="isModalOpen" Size="modal-lg">
    <div class="pb-5 px-sm-5 pt-50">
        <div class="text-center mb-2">
            <h1 class="mb-1">@(userDto.Id > 0 ? "Edit User Information" : "Create New User")</h1>
            <p>Fill in the user details and system credentials below.</p>
        </div>

        <EditForm Model="@userDto" OnValidSubmit="Save" class="row gy-1 pt-75">
            <DataAnnotationsValidator />

            <!-- User Name -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalUserName">User Name <span class="text-danger">*</span></label>
                <InputText id="modalUserName" class="form-control" @bind-Value="userDto.UserName" disabled="@isDisabled" placeholder="Enter username" />
                <ValidationMessage For="@(() => userDto.UserName)" class="text-danger small" />
            </div>

            <!-- Full Name -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalFullName">Full Name <span class="text-danger">*</span></label>
                <InputText id="modalFullName" class="form-control" @bind-Value="userDto.FullName" placeholder="Enter full name" />
                <ValidationMessage For="@(() => userDto.FullName)" class="text-danger small" />
            </div>

            <!-- Father Name -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalFatherName">Father Name <span class="text-danger">*</span></label>
                <InputText id="modalFatherName" class="form-control" @bind-Value="userDto.FatherName" placeholder="Enter father name" />
                <ValidationMessage For="@(() => userDto.FatherName)" class="text-danger small" />
            </div>

            <!-- Phone -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalPhone">Cell Phone No <span class="text-danger">*</span></label>
                <InputText id="modalPhone" class="form-control" @bind-Value="userDto.PhoneNo" />
                <ValidationMessage For="@(() => userDto.PhoneNo)" class="text-danger small" />
            </div>

            <!-- CNIC -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalCnic">NIC/Passport <span class="text-danger">*</span></label>
                <InputText id="modalCnic" class="form-control" @bind-Value="userDto.CNIC" />
                <ValidationMessage For="@(() => userDto.CNIC)" class="text-danger small" />
            </div>

            <!-- Email -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalEmail">Email <span class="text-danger">*</span></label>
                <InputText id="modalEmail" class="form-control" @bind-Value="userDto.Email" placeholder="example@domain.com" />
                <ValidationMessage For="@(() => userDto.Email)" class="text-danger small" />
            </div>
            <div class="col-12 col-md-6 mb-1">
                <label class="form-label">Assign Department<span class="text-danger">*</span></label>
                <KrSelect2 TItem="SetupDepartmentDto"
                           TValue="int"
                           Items="departmentsList"
                           
                           ValueSelector="@(u => u.Id)"
                           TextSelector="@(u => u.DepartmentName)"
                           @bind-Value="userDto.DepartmentId" />
                @if (!String.IsNullOrWhiteSpace(departmentError))
                {
                    <span class="text-danger small">@departmentError</span>
                }
            </div>

            <div class="col-12 col-md-6 mb-1">
                <label class="form-label">Assign Designation<span class="text-danger">*</span></label>
                <KrSelect2 TItem="SetupDesignationDto"
                           TValue="int"
                           Items="designationsList"
                           
                           ValueSelector="@(u => u.Id)"
                           TextSelector="@(u => u.DesignationName)"
                           @bind-Value="userDto.DesignationId" />
                @if (!String.IsNullOrWhiteSpace(designationError))
                {
                    <span class="text-danger small">@designationError</span>
                }
            </div>
            <!-- Password -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalPassword">Password <span class="text-danger">*</span></label>
                <InputText id="modalPassword" class="form-control" type="password" @bind-Value="userDto.HashPassword" disabled="@isDisabled" placeholder="••••••••" />
                <ValidationMessage For="@(() => userDto.HashPassword)" class="text-danger small" />
            </div>

           


            <!-- Confirm Password -->
            <div class="col-12 col-md-6">
                <label class="form-label" for="modalConfirmPassword">Confirm Password <span class="text-danger">*</span></label>
                <InputText id="modalConfirmPassword" class="form-control" type="password" @bind-Value="userDto.ConfirmPassword" disabled="@isDisabled" placeholder="••••••••" />
                <ValidationMessage For="@(() => userDto.ConfirmPassword)" class="text-danger small" />
            </div>

            <!-- Is Active Switch -->
            <div class="col-12">
                <div class="d-flex align-items-center mt-1">
                    <div class="form-check form-switch form-check-primary">
                        <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="userDto.IsActive" />
                        <label class="form-check-label" for="isActiveCheck"></label>
                    </div>
                    <label class="form-check-label fw-bolder ms-1" for="isActiveCheck">Is Active</label>
                </div>
            </div>

            <!-- Form Buttons -->
            <div class="col-12 text-center mt-2 pt-50">
                <button type="submit" class="btn btn-primary me-1">
                    @(userDto.Id > 0 ? "Update" : "Save")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => isModalOpen = false">
                    Discard
                </button>
            </div>
        </EditForm>
    </div>
</ModalPopup>


<ToastMessage @ref="toastRef" />

@code {
    private PaginationResponse<SetupUserDto> pagedResult = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private FilterModel filters { get; set; } = new();
    public List<SetupDepartmentDto> departmentsList = new();
    public List<SetupDesignationDto> designationsList= new();
    public SetupUserDto userDto { get; set; } = new();
    public UserSummary? userSummary { get; set; } = new();
    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private bool isDisabled = false;
    private string queryString = string.Empty;
    private Timer? debounceTimer;
    private string departmentError = "";
    private string designationError = "";
    private string currentSortColumn = string.Empty;
    private string currentSortType = "ASC";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadDataLists();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            pagedResult = await userService.GetAll(filters);

            userSummary = await userService.GetUsersSummary();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error fetching users: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDataLists()
    {
        try
        {
            departmentsList = await departmentService.GetDepartmentsList();
            designationsList = await designationService.GetDesignationsList();
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadData();
    }

    private async Task OpenModel()
    {
        try
        {
            userDto = new();
            isDisabled = false;
            isModalOpen = true;
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    private async Task EditUser(long id)
    {
        try
        {
            var found = await userService.GetById(id);
            if (found == null)
            {
                toastRef.Show("User not Found.", "error");
                isModalOpen = false;
            }
            isDisabled = true;
            userDto.Id = found.Id;
            userDto.UserName = found.UserName;
            userDto.FullName = found.FullName;
            userDto.FatherName = found.FatherName;
            userDto.CNIC = found.CNIC;
            userDto.Email = found.Email;
            userDto.PhoneNo = found.PhoneNo;
            userDto.DepartmentId = found.DepartmentId;
            userDto.DesignationId = found.DesignationId;
            userDto.HashPassword = found.HashPassword;
            userDto.ConfirmPassword = found.HashPassword;
            userDto.IsActive = found.IsActive;
            isModalOpen = true;

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }


    }

    private async Task Save()
    {
        try
        {
            int result;

            if (!await Validate())
            {
                return;
            }

            if (userDto.Id > 0)
            {
                result = await userService.Update(userDto);
            }
            else
            {
                result = await userService.Save(userDto);

            }
            if (result == 1)
            {
                toastRef.Show("User saved successfully!", "success");

                await LoadData();
                isModalOpen = false;
                userDto = new();
            }
            else if (result == -1)
            {
                toastRef.Show("User Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");

        }
    }
    private void HandleInput(ChangeEventArgs e)
    {
        queryString = e.Value?.ToString();
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (s, e) => await Search();
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }
    private async Task Search()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                pagedResult = await userService.GetAll(filters);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }

    private async Task<bool> Validate()
    {
        try
        {
            departmentError = string.Empty;
            designationError = string.Empty;

            bool isValid = true;

            if (userDto.DepartmentId <= 0)
            {
                departmentError = "Please Assign Department to this User.";
                isValid = false; 
            }

            if (userDto.DesignationId <= 0)
            {
                designationError = "Please Assign Designation to this User.";
                isValid = false; 
            }

            return isValid;
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
            return false;
        }
    }
    private async Task SortTable(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            currentSortType = currentSortType == "ASC" ? "DESC" : "ASC";
        }
        else
        {
            currentSortColumn = columnName;
            currentSortType = "ASC";
        }

        filters.ColumnName = currentSortColumn;
        filters.SortType = currentSortType;
        filters.PageNumber = currentPage;

        await LoadData();
    }

    private MarkupString GetSortIcon(string columnName)
    {
        if (currentSortColumn != columnName)
        {
            return new MarkupString("<i data-feather='menu' class='font-small-3 text-muted ms-50'></i>");
        }

        return currentSortType == "ASC"
            ? new MarkupString("<i data-feather='chevron-up' class='font-small-3 text-primary ms-50'></i>")
            : new MarkupString("<i data-feather='chevron-down' class='font-small-3 text-primary ms-50'></i>");
    }

    private async Task FilterUsers(string type)
    {
        try
        {
            filters.IsActive = type;

            await LoadData();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }
}