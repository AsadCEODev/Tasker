@page "/AssignProject"
@using TMS.Shared.Model.Setup
@using TMS.ClientServices
@using TMS.Components
@using TMS.Shared.Pagination
@using System.Timers



@inject IAssignProjectClientService thisService;
@inject IUserClientService userService;
@inject ISetupProjectClientService projectService;
@inject IJSRuntime JS

<div class="content-wrapper container-xxl-fluid p-0">
    <div class="content-header row">
    </div>
    <div class="content-body">
        <!-- users list start -->
        <section class="app-user-list">
            <div class="row">
                <div class="col-lg-4 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@TotalProjects</h3>
                                <span>Total Projects</span>
                            </div>
                            <div class="avatar bg-light-primary p-50">
                                <span class="avatar-content">
                                    <i data-feather="layers" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@TotalActiveProjects</h3>
                                <span>Active Projects</span>
                            </div>
                            <div class="avatar bg-light-success p-50">
                                <span class="avatar-content">
                                    <i data-feather="activity" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@TotalInActiveProjects</h3>
                                <span>InActive Projects</span>
                            </div>
                            <div class="avatar bg-light-danger p-50">
                                <span class="avatar-content">
                                    <i data-feather="pause-circle" class="font-medium-4"></i>
                                </span>
                            </div>
                            
                        </div>
                    </div>
                </div>
               
            </div>
            <!-- list and filter start -->
            <div class="card">

                <div class="card-body">

                    <!-- Top Toolbar -->
                    <div class="row align-items-center g-2 mb-3">

                        <!-- Left -->
                        <div class="col-md-3">

                            <h4 class="card-title mb-0">Search & Filter</h4>
                        </div>

                        <!-- Right -->
                        <div class="col-md-9">

                            <div class="d-flex justify-content-end gap-2">

                                <div class="d-flex align-items-center">
                                    <label class="me-2">Search:</label>
                                    <input class="form-control form-control-sm"
                                           style="width:200px;"
                                           placeholder="Search..." @oninput="HandleInput" />
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        <i data-feather="share"></i>
                                        Export
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                        <li><a class="dropdown-item" href="#">Excel</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>

                                    </ul>
                                </div>

                                <button class="btn btn-primary" @onclick="OpenModel">
                                    Assign Project
                                </button>

                            </div>

                        </div>

                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <div class="mt-1 fw-bold">
                                Loading users...
                            </div>
                        </div>
                    }
                    else
                    {


                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>User Name</th>
                                        <th>Full Name</th>
                                        <th>CNIC</th>
                                        <th>Assigned Projects</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (userProjectsList.Data == null || !userProjectsList.Data.Any())
                                    {
                                        <tr><td colspan="6" class="text-center py-5">No users found.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var user in userProjectsList.Data)
                                        {
                                            <tr>
                                                <td><span>@user.UserObj.UserName</span></td>
                                                <td><span>@user.UserObj.FullName</span></td>
                                                <td><span>@user.UserObj.CNIC</span></td>
                                                <td><span>@user.ProjectObj.ProjectName</span></td>
                                                <td>
                                                    <button class="btn btn-sm btn-icon btn-outline-danger" @onclick="() => RemoveAssignedProjct(user.Id)">
                                                        <i data-feather="trash" class="font-medium-3"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <!-- Footer -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        @if (userProjectsList != null && userProjectsList.TotalCount > 0)
                        {
                            
                            <span class="text-muted">
                                Showing page @userProjectsList.PageIndex of @userProjectsList.TotalPages
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No records to display</span>
                        }

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <!-- Previous Button -->
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage - 1)">‹</a>
                                </li>

                                <!-- Page Numbers -->
                                @if (userProjectsList != null && userProjectsList.TotalPages > 0)
                                {
                                    @for (int i = 1; i <= userProjectsList.TotalPages; i++)
                                    {
                                        int pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <a class="page-link" @onclick="() => OnPageChanged(pageNum)">@pageNum</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(userProjectsList == null || currentPage >= userProjectsList.TotalPages ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage + 1)">›</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <!-- list and filter end -->
        </section>
        <!-- users list ends -->
        
    </div>
</div>


<ModalPopup Title="Assign Project" @bind-IsVisible="isModalOpen">
    <EditForm Model="@assignProjectsDto" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="mb-1">
                <KrSelect2 TItem="SetupUserDto"
                           TValue="long"
                           Label="User"
                           Items="@usersList"
                           ValueSelector="@(u => u.Id)"
                           TextSelector="@(u => u.UserName)"
                           @bind-Value="assignProjectsDto.UserId"/>
            </div>
            <div class="mb-1">
                <KrSelect2 TItem="SetupProjectDto"
                           TValue="int"
                           Label="Project"
                           IsMultiple = "true"
                           Items="@projectsList"
                           ValueSelector="@(u => u.Id)"
                           TextSelector="@(u => u.ProjectName)"
                           @bind-Values="selectedIds" />
            </div>
        </div>
        
        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">
                @(UserProjectDto.Id > 0 ? "Update" : "Save")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => isModalOpen = false">Cancel</button>
        </div>
    </EditForm>
</ModalPopup>

<ToastMessage @ref="toastRef" />

@code {
    private PaginationResponse<UserProjectDto> userProjectsList = new();
    private int currentPage = 1;
    private int pageSize = 10;

    private int TotalProjects =0;
    private int TotalActiveProjects =0;
    private int TotalInActiveProjects =0;
    private List<SetupUserDto> usersList = new();
    private List<SetupProjectDto> projectsList = new();
    private List<int> selectedIds = new();
    private UserProjectDto UserProjectDto = new();
    private UserAssignProjectsDto assignProjectsDto = new();

    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private bool isDisabled = false;
    private string queryString = string.Empty;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadLists();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            userProjectsList = await thisService.GetAll(currentPage, pageSize, queryString);
            TotalProjects = userProjectsList.TotalCount;
            TotalActiveProjects = userProjectsList.Data.Count(p => p.IsActive);
            TotalInActiveProjects = userProjectsList.Data.Count(p => p.IsActive != true);
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    public async Task LoadLists()
    {
        try
        {
            usersList = await userService.GetUsersList();
            projectsList = await projectService.GetActiveList();
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadData();
    }

    private async Task OpenModel()
    {
        try
        {
            UserProjectDto = new();
            assignProjectsDto = new();
            isModalOpen = true;
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    private async Task RemoveAssignedProjct(long id)
    {
        try
        {
            var result = await thisService.Detele(id);
            if (result)
            {
                toastRef.Show("Project UnAssigned successfully!", "success");
                await LoadData();
                StateHasChanged();
            }
            else
            {
                toastRef.Show("Faild to Remove Assigned Project.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");
        }
    }

    private async Task Save()
    {
        try
        {
            assignProjectsDto.ProjectIds = selectedIds;
            var  result = await thisService.Save(assignProjectsDto);

            if (result)
            {
                toastRef.Show("Project Assigned successfully!", "success");

                await LoadData();
                isModalOpen = false;
                UserProjectDto = new();
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");

        }
    }


    private void HandleInput(ChangeEventArgs e)
    {
        queryString = e.Value?.ToString();

        // Debounce logic: 500ms tak wait karein
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (s, e) => await Search();
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task Search()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                userProjectsList = await thisService.GetAll(currentPage, pageSize, queryString);
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Error log karein
        }
    }

}