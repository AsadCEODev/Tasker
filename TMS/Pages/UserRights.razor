@page "/UserRightsPage"
@using TMS.Shared.Model.Setup
@using TMS.ClientServices
@using TMS.Components
@using TMS.Shared.Pagination
@using System.Timers



@inject IUserClientService userService;
@inject IJSRuntime JS

<div class="content-wrapper container-xxl p-0">
    <div class="content-header row">
    </div>
    <div class="content-body">
        <!-- users list start -->
        <section class="app-user-list">
            <div class="row">
                <div class="col-lg-3 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.TotalUserCount</h3>
                                <span>Total Users</span>
                            </div>
                            <div class="avatar bg-light-primary p-50">
                                <span class="avatar-content">
                                    <i data-feather="user" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.ActiveUserCount</h3>
                                <span>Active Users</span>
                            </div>
                            <div class="avatar bg-light-success p-50">
                                <span class="avatar-content">
                                    <i data-feather="user-check" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">@userSummary.InactiveUserCount</h3>
                                <span>InActive Users</span>
                            </div>
                            <div class="avatar bg-light-danger p-50">
                                <span class="avatar-content">
                                    <i data-feather="user-x" class="font-medium-4"></i>
                                </span>
                            </div>
                            
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-sm-6">
                    <div class="card">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="fw-bolder mb-75">0</h3>
                                <span>Pending Users</span>
                            </div>
                            <div class="avatar bg-light-warning p-50">
                                <span class="avatar-content">
                                    <i data-feather="user-plus" class="font-medium-4"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- list and filter start -->
            <div class="card">

                <div class="card-body">

                    <!-- Top Toolbar -->
                    <div class="row align-items-center g-2 mb-3">
                        <h3>Assign User Rights</h3>
                        <!-- Left -->
                        <div class="col-md-3">

                            <h4 class="card-title mb-0">Search & Filter</h4>
                        </div>

                        <!-- Right -->
                        <div class="col-md-9">

                            <div class="d-flex justify-content-end gap-2">

                                <div class="d-flex align-items-center">
                                    <label class="me-2">Search:</label>
                                    <input class="form-control form-control-sm"
                                           style="width:200px;"
                                           placeholder="Search..." @oninput="HandleInput" />
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        <i data-feather="share"></i>
                                        Export
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                        <li><a class="dropdown-item" href="#">Excel</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>

                                    </ul>
                                </div>

                                <button class="btn btn-primary" @onclick="OpenModel">
                                    Add New User
                                </button>

                            </div>

                        </div>

                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <div class="mt-1 fw-bold">
                                Loading users...
                            </div>
                        </div>
                    }
                    else
                    {


                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>User Name</th>
                                        <th>Full Name</th>
                                        <th>Father Name</th>
                                        <th>Email</th>
                                        <th>Phone No</th>
                                        <th>STATUS</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pagedResult.Data == null || !pagedResult.Data.Any())
                                    {
                                        <tr><td colspan="6" class="text-center py-5">No users found.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var user in pagedResult.Data)
                                        {
                                            <tr>
                                                <td><span>@user.UserName</span></td>
                                                <td><span>@user.FullName</span></td>
                                                <td><span>@user.FatherName</span></td>
                                                <td><span>@user.Email</span></td>
                                                <td><span>@user.PhoneNo</span></td>
                                                <td>
                                                    <span class="badge @(user.IsActive == true ? "bg-success" : "bg-danger")">
                                                        @(user.IsActive == true ? "Active" : "InActive")
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-icon btn-outline-primary" @onclick="() => EditUser(user.Id)">
                                                        <i data-feather="edit" class="font-medium-3"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <!-- Footer -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        @if (pagedResult != null && pagedResult.TotalCount > 0)
                        {
                            
                            <span class="text-muted">
                                Showing page @pagedResult.PageIndex of @pagedResult.TotalPages
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No records to display</span>
                        }

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <!-- Previous Button -->
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage - 1)">‹</a>
                                </li>

                                <!-- Page Numbers -->
                                @if (pagedResult != null && pagedResult.TotalPages > 0)
                                {
                                    @for (int i = 1; i <= pagedResult.TotalPages; i++)
                                    {
                                        int pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <a class="page-link" @onclick="() => OnPageChanged(pageNum)">@pageNum</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(pagedResult == null || currentPage >= pagedResult.TotalPages ? "disabled" : "")">
                                    <a class="page-link" @onclick="() => OnPageChanged(currentPage + 1)">›</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <!-- list and filter end -->
        </section>
        <!-- users list ends -->
        
    </div>
</div>


<ModalPopup Title="User Details" @bind-IsVisible="isModalOpen">
    <EditForm Model="@userDto" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="col-md-6 mb-1">
                <label class="form-label">User Name<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.UserName" disabled="@isDisabled"  />
                <ValidationMessage For="@(() => userDto.UserName)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Full Name<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.FullName"  />
                <ValidationMessage For="@(() => userDto.FullName)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Full Name<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.FatherName" />
                <ValidationMessage For="@(() => userDto.FatherName)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Phone<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.PhoneNo" />
                <ValidationMessage For="@(() => userDto.PhoneNo)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">CNIC<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.CNIC"  />
                <ValidationMessage For="@(() => userDto.CNIC)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Email<span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="userDto.Email"  />
                <ValidationMessage For="@(() => userDto.Email)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Password<span class="text-danger">*</span></label>
                <InputText class="form-control" type="password" @bind-Value="userDto.HashPassword" disabled="@isDisabled" />
                <ValidationMessage For="@(() => userDto.HashPassword)" />
            </div>
            <div class="col-md-6 mb-1">
                <label class="form-label">Confirm Password<span class="text-danger">*</span></label>
                <InputText class="form-control" type="password" @bind-Value="userDto.ConfirmPassword" disabled="@isDisabled" />
                <ValidationMessage For="@(() => userDto.ConfirmPassword)" />
            </div>
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch">
                    <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="userDto.IsActive" />
                    <label class="form-check-label" for="isActiveCheck">Is Active</label>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">
                @(userDto.Id > 0 ? "Update" : "Save")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => isModalOpen = false">Cancel</button>
        </div>
    </EditForm>
</ModalPopup>

<ToastMessage @ref="toastRef" />

@code {
    private PaginationResponse<SetupUserDto> pagedResult = new();
    private int currentPage = 1;
    private int pageSize = 10;

    public SetupUserDto userDto { get; set; } = new();
    public UserSummary? userSummary { get; set; } = new();
    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private bool isDisabled = false;
    private string queryString = string.Empty;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            pagedResult = await userService.GetAll(currentPage, pageSize, queryString);

            userSummary = await userService.GetUsersSummary();
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error fetching users: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadData();
    }

    private async Task OpenModel()
    {
        try
        {
            userDto = new();
            isDisabled = false;
            isModalOpen = true;
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }


    private async Task EditUser(long id)
    {
        try
        {
            var found = await userService.GetById(id);
            if (found == null)
            {
                toastRef.Show("User not Found.", "error");
                isModalOpen = false;
            }
            isDisabled = true;
            userDto.Id = found.Id;
            userDto.UserName = found.UserName;
            userDto.FullName = found.FullName;
            userDto.CNIC = found.CNIC;
            userDto.Email = found.Email;
            userDto.PhoneNo = found.PhoneNo;
            userDto.HashPassword = found.HashPassword;
            userDto.ConfirmPassword = found.HashPassword;
            userDto.IsActive = found.IsActive;

            isModalOpen = true;

        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }


    }

    private async Task Save()
    {
        try
        {
            int result;

            if(userDto.Id > 0)
            {
                result = await userService.Update(userDto);
            }
            else
            {
                result = await userService.Save(userDto);

            }
            if (result == 1)
            {
                toastRef.Show("User saved successfully!", "success");

                await LoadData();
                isModalOpen = false;
                userDto = new();
            }
            else if(result == -1)
            {
                toastRef.Show("User Name already Exist.", "error");
            }
            else
            {
                toastRef.Show("Faild to Save.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef.Show($"Error: {ex.Message}", "error");

        }
    }


    private void HandleInput(ChangeEventArgs e)
    {
        queryString = e.Value?.ToString();

        // Debounce logic: 500ms tak wait karein
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (s, e) => await Search();
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task Search()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                pagedResult = await userService.GetAll(currentPage, pageSize, queryString);
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Error log karein
        }
    }

}