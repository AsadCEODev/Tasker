@page "/TodoTasks"
@using TMS.ClientServices
@using TMS.Shared.Pagination
@using TMS.Shared.Model.Setup
@using TMS.Shared.Model
@using TMS.Shared.Enum
@using TMS.Shared.Model.Filters
@using TMS.Components
@using TMS.ClientServices.TimerGlobalService
@using TMS.ClientServices.StateUser


@inject UserStateService UserState
@inject IUserAssignedTaskClientService userTaskService;
@inject ITaskClientService thisService;
@inject ITagsClientService tagService;
@inject IStatusClientService StatusService;
@inject ISetupProjectClientService projectService;
@inject IUserClientService usersService;
@inject ActiveTaskTimerService TimerService;
@inject HttpClient Http;
@implements IDisposable;
@inject IJSRuntime JS


<!-- BEGIN: Content-->
<div class="todo-application">

    <div class="content-overlay"></div>
    <div class="header-navbar-shadow"></div>
    <div class="content-area-wrapper p-0">

        <div class="sidebar-left">
            <div class="sidebar">
                <div class="sidebar-content todo-sidebar">
                    <div class="todo-app-menu">
                        <div class="add-task">
                            <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#new-task-modal" @onclick="ClearModel">
                                Create Task
                            </button>
                        </div>
                        <div class="sidebar-menu-list">
                            <div class="list-group list-group-filters">
                                @if (statusList != null && taskSummaryDto != null)
                                {
                                    <a href="#" class="list-group-item list-group-item-action @(!filters.StatusId.HasValue ? "active" : "")"
                                       @onclick="() => FilterByStatus(0)">
                                        <i data-feather="mail" class="font-medium-3 me-50"></i>
                                        <span class="align-middle">
                                            My All Tasks
                                            <span class="badge bg-primary float-end">@taskSummaryDto.TotalTasks</span>
                                        </span>
                                    </a>

                                    @foreach (var status in statusList)
                                    {
                                        int statusCount = status.Id switch
                                        {
                                            (int)StatusEnum.Pending => taskSummaryDto.TotalPendingTasks,
                                            (int)StatusEnum.Inprocess => taskSummaryDto.TotalInProcessTasks,
                                            (int)StatusEnum.Completed => taskSummaryDto.TotalCompletedTasks,
                                            _ => 0
                                        };

                                        <a href="#" class="list-group-item list-group-item-action @(filters.StatusId == status.Id ? "active" : "")"
                                           @onclick="() => FilterByStatus(status.Id)">

                                            <i data-feather="@status.Icon" class="font-medium-3 me-50"></i>

                                            <span class="align-middle">
                                                @status.StatusTitle
                                                <span class="badge bg-secondary float-end">@statusCount</span>
                                            </span>
                                        </a>
                                    }
                                }
                            </div>
                            <div class="mt-3 px-2 d-flex justify-content-between">
                                <h6 class="section-label mb-1">Task Priority</h6>
                                <i data-feather="plus" class="cursor-pointer"></i>
                            </div>

                            <div class="list-group list-group-labels">
                                @if (tagList != null && taskSummaryDto != null)
                                {
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(!filters.TagId.HasValue ? "active" : "")"
                                       @onclick="() => FilterByTag(0)">
                                        <div>
                                            <span class="bullet bullet-sm me-1" style="background-color: cadetblue;"></span>
                                            <span class="align-middle">All Tags</span>
                                        </div>
                                        <span class="badge bg-primary">@taskSummaryDto.TotalTasks</span>
                                    </a>

                                    @foreach (var tag in tagList)
                                    {

                                        int tagCount = tag.Id switch
                                        {
                                            (int)TagEnum.low => taskSummaryDto.TotalLowTasks,
                                            (int)TagEnum.medium => taskSummaryDto.TotalMediumTasks,
                                            (int)TagEnum.high => taskSummaryDto.TotalHighTasks,
                                            _ => 0
                                        };

                                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filters.TagId == tag.Id ? "active" : "")"
                                           @onclick="() => FilterByTag(tag.Id)">
                                            <div>
                                                <span class="bullet bullet-sm me-1" style="background-color: @tag.Color;"></span>
                                                <span class="align-middle">@tag.TagTitle</span>
                                            </div>
                                            <span class="badge bg-secondary">@tagCount</span>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="content-right">
            <div class="content-wrapper p-0">
                <!-- Main Fixed Height App Body Container -->
                <div class="content-body d-flex flex-column" style="height: calc(100vh - 130px); overflow: hidden;">

                    <div class="body-content-overlay"></div>

                    <div class="todo-app-list d-flex flex-column h-100 bg-white">

                        <!-- Todo Search Header (Fixed Top) -->
                        <div class="app-fixed-search d-flex flex-column flex-md-row align-items-stretch align-md-center p-3 border-bottom bg-white flex-shrink-0 gap-2">
                            <div class="d-flex align-items-center w-100 gap-2">
                                <div class="sidebar-toggle d-block d-lg-none">
                                    <i data-feather="menu" class="font-medium-5"></i>
                                </div>

                                <div class="input-group input-group-merge flex-grow-1">
                                    <span class="input-group-text"><i data-feather="search" class="text-muted"></i></span>
                                    <input type="text" class="form-control" id="todo-search-input" placeholder="Search task..." aria-label="Search..."
                                           @bind="filters.QueryString" @oninput="OnSearchInput" />
                                </div>
                            </div>

                            <!-- Date Filters Section -->
                            <div class="d-flex align-items-center justify-content-end gap-2 w-100 w-md-auto flex-wrap flex-sm-nowrap">

                                <!-- From Date -->
                                <div class="d-flex align-items-center gap-1 flex-grow-1 flex-sm-grow-0">
                                    <label class="form-label mb-0 text-nowrap small text-muted">From:</label>
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="filters.FromDate" @bind:after="LoadData" />
                                </div>

                                <!-- To Date -->
                                <div class="d-flex align-items-center gap-1 flex-grow-1 flex-sm-grow-0">
                                    <label class="form-label mb-0 text-nowrap small text-muted">To:</label>
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="filters.ToDate" @bind:after="LoadData" />
                                </div>

                            </div>

                        </div>
                        <!-- Todo search ends -->
                        <!-- Todo Cards Scrollable Container (Takes remaining flexible space and scrolls internally) -->
                        @if (isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>

                                <div class="mt-1 fw-bold">
                                    Loading Tasks...
                                </div>
                            </div>
                        }
                        else
                        {

                            <div class="todo-cards-scroll-container flex-grow-1 overflow-auto p-1 bg-light">
                                <div class="row g-2">

                                    @if (userTaskList?.Data != null && userTaskList.Data.Any())
                                    {
                                        @foreach (var task in userTaskList.Data)
                                        {
                                            <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                                                <div class="card h-100 border-0 shadow-sm rounded-3 mb-0"
                                                     style="cursor:pointer;"
                                                     data-bs-toggle="modal"
                                                     data-bs-target="#new-task-modal"
                                                     @onclick="() => Edit(task)">

                                                    <div class="card-body p-2">

                                                        <!-- HEADER -->
                                                        <!-- HEADER -->
                                                        <div class="d-flex justify-content-between align-items-start">

                                                            <!-- Yahan class ki bajaye inline style use karein -->
                                                            <div class="flex-grow-1 pe-2" style="min-width: 0;">

                                                                <div class="d-flex align-items-center gap-50 mb-25">

                                                                    <span class="badge rounded-pill @GetPriorityHeader(task.TagTitle)">
                                                                        @(task.TagTitle ?? "Low")
                                                                    </span>

                                                                    <small class="text-muted">
                                                                        Task
                                                                    </small>
                                                                    @if (!string.IsNullOrWhiteSpace(task.FileName)) // Yahan apni condition ya property laga lein (e.g. task.Attachments?.Any() == true)
                                                                    {
                                                                        <div class="text-muted" title="Has Attachment">
                                                                            <i data-feather="paperclip" class="font-small-4"></i>
                                                                        </div>
                                                                    }
                                                                </div>

                                                                <!-- TEXT TRUNCATE -->
                                                                <h6 class="fw-bolder text-dark mb-0 text-truncate">
                                                                    @task.TaskTitle
                                                                </h6>

                                                            </div>

                                                            <!-- PROGRESS CIRCLE -->
                                                            <div class="text-center flex-shrink-0">
                                                                <!-- (Progress circle ka baki code wese hi rahega) -->
                                                                <div class="position-relative">
                                                                    <svg width="52" height="52" viewBox="0 0 80 80" style="transform:rotate(-90deg);">
                                                                        <circle cx="40" cy="40" r="34" fill="none" stroke="#eeeeee" stroke-width="7"></circle>
                                                                        <circle cx="40" cy="40" r="34" fill="none" stroke="#7367f0" stroke-width="7" stroke-linecap="round" stroke-dasharray="213.6" style="stroke-dashoffset:@GetProgressOffset(task.UserProgress ?? 0);"></circle>
                                                                    </svg>
                                                                    <span class="position-absolute top-50 start-50 translate-middle fw-bolder" style="font-size:10px;">
                                                                        @task.UserProgress%
                                                                    </span>
                                                                </div>
                                                            </div>

                                                        </div>


                                                        <!-- STATUS -->
                                                        <div class="d-flex justify-content-between align-items-center mt-1">

                                                            <div class="d-flex align-items-center gap-50">

                                                                <small class="text-muted">
                                                                    Status
                                                                </small>

                                                                <span class="badge rounded-pill @GetStatusBadge(task.StatusTitle ?? "Pending")">
                                                                    @(task.StatusTitle ?? "Pending")
                                                                </span>

                                                            </div>

                                                            <span class="fw-bolder font-small-2 text-dark">
                                                                @task.UserProgress%
                                                            </span>

                                                        </div>


                                                        <!-- PROGRESS BAR -->
                                                        <div class="progress mt-50"
                                                             style="height:4px;">

                                                            <div class="progress-bar rounded-pill"
                                                                 style="width:@task.UserProgress%">
                                                            </div>

                                                        </div>


                                                        <!-- DESCRIPTION -->
                                                        <div class="mt-1">

                                                            <small class="text-muted d-block">
                                                                Description
                                                            </small>

                                                            <p class="text-muted font-small-2 mb-0 text-truncate">
                                                                @(string.IsNullOrWhiteSpace(task.TaskDesc)
                                                                    ? "No description provided."
                                                                    : task.TaskDesc)
                                                            </p>

                                                        </div>


                                                        <!-- PROJECT + ASSIGNED -->
                                                        <div class="row g-1 mt-1">

                                                            <!-- PROJECT -->
                                                            <div class="col-6">

                                                                <div class="d-flex align-items-center gap-50
                                                                    bg-light-primary rounded p-50">

                                                                    <div class="avatar bg-primary">

                                                                        <div class="avatar-content">

                                                                            <i data-feather="briefcase"
                                                                               class="font-small-4">
                                                                            </i>

                                                                        </div>

                                                                    </div>

                                                                    <div class="min-w-0">

                                                                        <small class="text-muted d-block font-small-1">
                                                                            Project
                                                                        </small>

                                                                        <span class="fw-bolder font-small-2
                                                                            text-dark d-block text-truncate">

                                                                            @(task.ProjectName ?? "UnAssigned")

                                                                        </span>

                                                                    </div>

                                                                </div>

                                                            </div>


                                                            <!-- ASSIGNED -->
                                                            <div class="col-6">

                                                                <div class="d-flex align-items-center gap-50
                                                                    bg-light-success rounded p-50">

                                                                    <div class="avatar bg-success">

                                                                        <div class="avatar-content">

                                                                            <i data-feather="user"
                                                                               class="font-small-4">
                                                                            </i>

                                                                        </div>

                                                                    </div>

                                                                    <div class="min-w-0">

                                                                        <small class="text-muted d-block font-small-1">
                                                                            Assigned
                                                                        </small>

                                                                        <span class="fw-bolder font-small-2 text-dark d-block text-truncate">
                                                                            @(task.AssignedUsersCount == 0
                                                                                ? "UnAssigned"
                                                                                : task.AssignedUsersCount == 1
                                                                                    ? task.FullName ?? "UnAssigned"
                                                                                    : "Team")
                                                                        </span>

                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>


                                                        <!-- FOOTER -->
                                                        <div class="d-flex justify-content-between align-items-center
                                                            border-top mt-1 pt-1">

                                                            <!-- DATE -->
                                                            <div class="d-flex align-items-center gap-50">

                                                                <i data-feather="calendar"
                                                                   class="text-muted font-small-4">
                                                                </i>

                                                                <div>

                                                                    <small class="text-muted d-block font-small-1">
                                                                        Due Date
                                                                    </small>

                                                                    <span class="fw-bolder font-small-2">
                                                                        @task.DueDate.ToString("dd MMM yyyy")
                                                                    </span>

                                                                </div>

                                                            </div>


                                                            <!-- TIME -->
                                                            <div class="d-flex align-items-center gap-50">

                                                                <i data-feather="clock"
                                                                   class="text-muted font-small-4">
                                                                </i>

                                                                <div>

                                                                    <small class="text-muted d-block font-small-1">
                                                                        Time
                                                                    </small>

                                                                    <span class="fw-bolder font-small-2">
                                                                        @task.DueDate.ToString("hh:mm tt")
                                                                    </span>

                                                                </div>

                                                            </div>


                                                        </div>

                                                    </div>

                                                </div>

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-12">

                                            <div class="card border-0 shadow-sm">
                                                <div class="card-body text-center py-4">

                                                    <i data-feather="clipboard"
                                                       class="font-large-1 text-muted mb-1">
                                                    </i>

                                                    <h6 class="fw-bolder mb-25">
                                                        No Tasks Found
                                                    </h6>

                                                    <small class="text-muted">
                                                        There are currently no tasks available.
                                                    </small>

                                                </div>
                                            </div>

                                        </div>
                                    }

                                </div>
                            </div>
                            <!-- Todo Cards Scrollable Container ends -->
                        }
                        <!-- Pagination Footer Bar (Fixed at bottom inside the list layout) -->
                        <div class="d-flex justify-content-between align-items-center mb-2 px-3 py-2 border-top bg-white flex-shrink-0">
                            @if (taskList != null && taskList.TotalCount > 0)
                            {
                                <span class="text-muted small">
                                    Showing page @taskList.PageIndex of @taskList.TotalPages (Total: @taskList.TotalCount)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">No records to display</span>
                            }

                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Previous Button -->
                                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                        <button class="page-link" type="button" @onclick="() => OnPageChanged(currentPage - 1)" disabled="@(currentPage <= 1)">‹</button>
                                    </li>

                                    <!-- Page Numbers -->
                                    @if (taskList != null && taskList.TotalPages > 0)
                                    {
                                        @for (int i = 1; i <= taskList.TotalPages; i++)
                                        {
                                            int pageNum = i;
                                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                                <button class="page-link" type="button" @onclick="() => OnPageChanged(pageNum)">@pageNum</button>
                                            </li>
                                        }
                                    }

                                    <!-- Next Button -->
                                    <li class="page-item @(taskList == null || currentPage >= taskList.TotalPages ? "disabled" : "")">
                                        <button class="page-link" type="button" @onclick="() => OnPageChanged(currentPage + 1)" disabled="@(taskList == null || currentPage >= taskList.TotalPages)">›</button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                        <!-- Pagination footer ends -->

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Dynamic Modal: Shows Edit version if Id != 0, otherwise shows Create version -->
<div class="modal modal-slide-in sidebar-todo-modal fade @(isModalOpen ? "show d-block" : "")" id="new-task-modal">
    <div class="modal-dialog sidebar-lg">
        <div class="modal-content p-0">
            <EditForm Model="@setupTaskDto" OnValidSubmit="Save" class="todo-modal">
                <DataAnnotationsValidator />

                <div class="modal-header align-items-center mb-1">
                    <h5 class="modal-title">@(setupTaskDto.Id == 0 ? "Add Task" : "Edit Task")</h5>
                    <div class="todo-item-action d-flex align-items-center justify-content-between ms-auto">
                        <span class="todo-item-favorite cursor-pointer me-75">
                            <i data-feather="star" class="font-medium-2"></i>
                        </span>
                        <i data-feather="x" class="cursor-pointer" data-bs-dismiss="modal" stroke-width="3" @onclick="ClearModel"></i>
                    </div>
                </div>

                <div class="modal-body flex-grow-1 pb-sm-0 pb-3">

                    @if (setupTaskDto.Id != 0)
                    {
                        <!-- Task Timer & Action Button -->
                        <div class="mb-1 d-flex align-items-center justify-content-between border rounded-3 p-2 bg-light">
                            <!-- Task Timer Button -->
                            <button type="button"
                                    class="btn @(isTaskStarted ? "btn-danger" : "btn-success") rounded-pill px-2 d-flex align-items-center gap-2 shadow-sm"
                                    @onclick="ToggleTaskTimer"
                                    title="@(isTaskStarted ? "Pause Task" : "Start Task")">
                                @if (isTaskStarted)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="6" y="4" width="4" height="16"></rect>
                                        <rect x="14" y="4" width="4" height="16"></rect>
                                    </svg>
                                    <span class="fw-semibold">Pause</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
                                        <polygon points="6 3 20 12 6 21 6 3"></polygon>
                                    </svg>
                                    <span class="fw-semibold">Start</span>
                                }
                            </button>
                            <div>
                                <span class="text-muted small d-block mb-1">Task Time Counter</span>
                                <span class="fs-4 fw-bold font-monospace text-primary">
                                    @elapsedtime.ToString(@"hh\:mm\:ss")
                                </span>
                            </div>
                        </div>
                    }

                    <div class="action-tags">
                        <div class="mb-1">
                            <label for="todoTitleAdd" class="form-label">Title</label>
                            <!-- Title is disabled during edit if you prefer, or keep standard -->
                            <InputText id="todoTitleAdd" class="new-todo-item-title form-control" @bind-Value="setupTaskDto.TaskTitle" placeholder="Title" disabled="@(setupTaskDto.Id != 0)" />
                            <ValidationMessage For="@(() => setupTaskDto.TaskTitle)" class="text-danger small" />
                        </div>

                        <div class="@(setupTaskDto.Id != 0 ? "mb-1" : "mb-1")">
                            <label for="task-due-date" class="form-label">Due Date and Time</label>
                            <InputDate Type="InputDateType.DateTimeLocal" id="task-due-date" class="form-control w-100" @bind-Value="setupTaskDto.DueDate" style="cursor: pointer;" disabled="@(setupTaskDto.Id != 0)" />
                            <ValidationMessage For="@(() => setupTaskDto.DueDate)" class="text-danger small" />
                        </div>
                        @if (setupTaskDto.Id == 0)
                        {
                            <div class="mb-1">
                                <KrSelect2 TItem="SetupTagDto"
                                           TValue="int"
                                           Label="Task Priority"
                                           Items="@tagList"
                                           ValueSelector="@(u => u.Id)"
                                           TextSelector="@(u => u.TagTitle)"
                                           @bind-Value="setupTaskDto.TagId"
                                           Disabled="@(setupTaskDto.Id != 0)" />
                                <ValidationMessage For="@(() => setupTaskDto.TagId)" class="text-danger small mt-0" />
                            </div>

                            <div class="mb-1">
                                <KrSelect2 TItem="SetupProjectDto"
                                           TValue="int"
                                           Label="Project"
                                           Items="@projectsList"
                                           ValueSelector="@(u => u.Id)"
                                           TextSelector="@(u => u.ProjectName)"
                                           @bind-Value="setupTaskDto.ProjectId"
                                           Disabled="@(setupTaskDto.Id != 0)" />
                                <ValidationMessage For="@(() => setupTaskDto.ProjectId)" class="text-danger small" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-1">
                                <label class="form-label">Progress Percentage</label>
                                <InputNumber class="new-todo-item-title form-control" @bind-Value="setupTaskDto.Progress" />
                                <ValidationMessage For="@(() => setupTaskDto.Progress)" class="text-danger small" />
                            </div>
                        }
                        @* <div class="mb-1">
                            <KrSelect2 TItem="SetupUserDto"
                                       TValue="long"
                                       Label="User"
                                       IsMultiple="true"
                                       Items="@usersList"
                                       ValueSelector="@(u => u.Id)"
                                       TextSelector="@(u => u.UserName)"
                                       @bind-Values="selectedIds"
                                       Disabled="@(setupTaskDto.Id != 0)" />

                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <div class="text-danger">@ErrorMessage</div>
                            }
                        </div> *@
                        <div class="mb-1">

                           
                            @if (!string.IsNullOrEmpty(setupTaskDto.FileName))
                            {
                                <label for="task-file" class="form-label">Admin's Attached File</label>
                                <div class="d-flex align-items-center justify-content-between border rounded p-1 mb-1 bg-light">
                                    <span class="text-truncate text-primary" style="max-width: 180px;" title="@setupTaskDto.FileName">
                                        <i data-feather="file" class="me-50 font-medium-2"></i> @setupTaskDto.FileName
                                    </span>
                                    <div class="d-flex gap-1">
                                        <a href="/Files/@setupTaskDto.FileName" target="_blank" class="btn btn-sm btn-outline-primary" download>
                                            Download
                                        </a>
                                    </div>
                                </div>

                            }

                            @* <InputFile id="task-file" class="form-control" OnChange="HandleFileSelection" /> *@
                        </div>
                        <div class="mb-1">
                            <label for="task-file" class="form-label">Attach File</label>

                            @if (!string.IsNullOrEmpty(setupTaskDto.UserFileName))
                            {
                                <div class="d-flex align-items-center justify-content-between border rounded p-1 mb-1 bg-light">
                                    <span class="text-truncate text-primary" style="max-width: 180px;" title="@setupTaskDto.UserFileName">
                                        <i data-feather="file" class="me-50 font-medium-2"></i> @setupTaskDto.UserFileName
                                    </span>
                                    <div class="d-flex gap-1">
                                        <a href="/Files/@setupTaskDto.UserFileName" target="_blank" class="btn btn-sm btn-outline-primary" download>
                                            Download
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveUserFile">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            }

                            <InputFile id="task-file" class="form-control" OnChange="HandleFileSelection" />
                        </div>

                        <div class="mb-1">
                            <label for="task-desc" class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="setupTaskDto.TaskDesc" rows="4" disabled="@(setupTaskDto.Id != 0)" />
                            <ValidationMessage For="@(() => setupTaskDto.TaskDesc)" class="text-danger small" />
                        </div>

                    </div>
                    @if (setupTaskDto.Id != 0)
                    {
                        <div class="mb-1">
                            <label class="form-label">Remarks</label>
                            <InputTextArea class="form-control" @bind-Value="setupTaskDto.Remarks" rows="4"></InputTextArea>
                            <ValidationMessage For="@(() => setupTaskDto.Remarks)" class="text-danger small" />
                        </div>
                    }
                    <div class="my-1 d-flex align-items-center flex-wrap gap-1">
                        @if (setupTaskDto.Id == 0)
                        {
                            <button type="submit" class="btn btn-primary">Save & New</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary">Update</button>
                            @* <button type="button" class="btn btn-outline-danger" @onclick="Delete">Delete</button> *@
                        }
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" @onclick="ClearModel">Close</button>
                    </div>

                </div>
            </EditForm>
        </div>
    </div>
</div>

<ToastMessage @ref="toastRef" />
<!-- END: Content-->
@code {
    private PaginationResponse<SetupTaskDto> taskList = new();
    private PaginationResponse<UserTaskDataDto> userTaskList = new();
    private FilterDto filters = new();
    private IBrowserFile? selectedFile;
    private IBrowserFile? userSelectedFile;

    private UserTaskDto userTaskDto = new();
    private SetupTaskDto setupTaskDto = new();

    private List<SetupTagDto> tagList = new();
    private List<SetupUserDto> usersList = new();
    private List<SetupProjectDto> projectsList = new();
    private List<SetupStatusDto> statusList = new();
    private TaskSummaryDto taskSummaryDto = new();

    private int currentPage = 1;
    private int pageSize = 12;

    public bool isLoading { get; set; } = true;
    private ToastMessage toastRef { get; set; } = new();
    private bool isModalOpen = false;
    private Timer? debounceTimer;
    private int selectedTagId;
    private List<long> selectedIds = new();
    private string ErrorMessage = string.Empty;

    private CancellationTokenSource? _timerCts;
    private bool isTaskStarted => TimerService.ActiveTaskId == setupTaskDto.Id;
    private TimeSpan elapsedtime => TimerService.GetElapsedTime(setupTaskDto.Id, GetStoredTimeSpan());
    private SetupUser? currentUser;
}

@code {
    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserState.GetCurrentUserAsync();

        filters.ToDate = DateTime.Today;

        filters.FromDate = DateTime.Today.AddDays(-7);
        await LoadData();
        await LoadLists();
        TimerService.OnTick += () => InvokeAsync(StateHasChanged);
        TimerService.OnStateChange += () => InvokeAsync(StateHasChanged);

    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            filters.PageNumber = currentPage;
            filters.PageSize = pageSize;
            userTaskList = await userTaskService.GetTasksByUser(filters);

            if (userTaskList != null && userTaskList.TotalPages > 0 && currentPage > userTaskList.TotalPages)
            {
                currentPage = 1;
                filters.PageNumber = currentPage;
                userTaskList = await userTaskService.GetTasksByUser(filters);
            }

            taskSummaryDto = await thisService.GetUserTodoTasksSummary(filters);
        }
        catch (Exception ex)
        {
            toastRef?.Show($"Error loading tasks: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLists()
    {
        try
        {
            tagList = await tagService.GetAll();
            projectsList = await projectService.GetActiveList();
            usersList = await usersService.GetUsersList();
            statusList = await StatusService.GetAll();

        }
        catch (Exception ex)
        {
            toastRef?.Show($"Error loading lists: {ex.Message}", "error");
        }
    }
    private async Task OnPageChanged(int newPage)
    {
        if (taskList != null && newPage >= 1 && newPage <= taskList.TotalPages && newPage != currentPage)
        {
            currentPage = newPage;
            await LoadData();
        }
    }

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        userSelectedFile = e.File;
    }

    private void RemoveUserFile()
    {
        setupTaskDto.UserFileName = string.Empty;
        userSelectedFile = null;
        StateHasChanged();
    }
    private async Task Save()
    {
        try
        {

            
            if (isTaskStarted)
            {
                toastRef?.Show("This Task is Running. Please Stop it First.", "error");
                return;
            }
            userTaskDto.Remarks = setupTaskDto.Remarks;
            userTaskDto.UserProgress = setupTaskDto.Progress;
            userTaskDto.TaskId = setupTaskDto.Id;



            bool result = await userTaskService.UpdateUserTask(userTaskDto, userSelectedFile);

            if (result)
            {
                ClearModel();
                await LoadData();
                toastRef?.Show("Task Updated.", "success");
            }
            else
            {
                toastRef?.Show("Operation Failed.", "error");
            }
        }
        catch (Exception ex)
        {

            throw new Exception(ex.Message);
        }


    }

    private string GetPriorityHeader(string priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "bg-danger",
            "medium" => "bg-warning",
            "low" => "bg-secondary",
            _ => "bg-primary"
        };
    }

    private string GetStatusBadge(string status)
    {
        var cleanedStatus = status?.Trim().ToLower();

        return cleanedStatus switch
        {
            "completed" => "bg-light-success text-success border border-success-subtle",
            "pending" => "bg-light-warning text-warning border border-warning-subtle",
            "inprocess" => "bg-light-primary text-primary border border-primary-subtle",
            _ => "bg-light-secondary text-secondary border border-secondary-subtle"
        };
    }

    private double GetProgressOffset(int progress)
    {
        progress = Math.Clamp(progress, 0, 100);

        double circumference = 2 * Math.PI * 34;

        return circumference - (circumference * progress / 100);
    }

    private void Edit(UserTaskDataDto task)
    {
        try
        {

            setupTaskDto = new SetupTaskDto
            {
                Id = task.TaskId,
                TaskTitle = task.TaskTitle,
                TaskDesc = task.TaskDesc,
                DueDate = task.DueDate,
                FileName = task.FileName,
                UserFileName = task?.UserFileName,
                Remarks = task?.Remarks,
                ProjectId = task.ProjectId,
                TagId = task.TagId,
                Progress = task.UserProgress,
                UserTasks = new List<UserTaskDto>
                {
                    new UserTaskDto
                    {
                        UserId = task.UserId,
                        TaskId = task.TaskId,
                        IsStart = task.IsStart,
                        TaskTime = task.TaskTime,
                        UserProgress = task?.UserProgress
                    }
                }
            };

        }
        catch (Exception ex)
        {
            toastRef?.Show($"Error preparing task for edit: {ex.Message}", "error");
        }
    }


    private async Task Delete()
    {
        try
        {
            if (setupTaskDto.Id == 0) return;

            bool success = await thisService.Delete(setupTaskDto.Id);

            if (success)
            {
                setupTaskDto = new SetupTaskDto();
                toastRef.Show("Task deleted successfully.", "success");
                await LoadData();
            }
            else
            {
                toastRef.Show("Failed to delete task.", "error");
            }
        }
        catch (Exception ex)
        {
            toastRef?.Show($"Error deleting task: {ex.Message}", "error");
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        filters.QueryString = e.Value?.ToString();

        debounceTimer?.Dispose();

        debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private async Task FilterByTag(int tagId)
    {
        filters.TagId = tagId;
        await LoadData();
    }
    private async Task FilterByStatus(int statusId)
    {
        filters.StatusId = statusId;
        await LoadData();
    }

    private void ClearModel()
    {
        setupTaskDto = new SetupTaskDto();
        selectedIds = null;
    }

    private TimeSpan GetStoredTimeSpan()
    {
        var currentUserTask = setupTaskDto?.UserTasks?.FirstOrDefault();
        if (currentUserTask != null && currentUserTask.TaskTime.HasValue)
        {
            return TimeSpan.FromSeconds(currentUserTask.TaskTime.Value);
        }
        return TimeSpan.Zero;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (setupTaskDto?.UserTasks != null && setupTaskDto.UserTasks.Any(x => x.IsStart) && TimerService.ActiveTaskId != setupTaskDto.Id)
        {
            TimerService.StartOrResumeTimer(setupTaskDto.Id, GetStoredTimeSpan());
        }
    }

    private async Task ToggleTaskTimer()
    {
        var currentUserTask = setupTaskDto?.UserTasks?.FirstOrDefault();
        if (currentUserTask == null) return;

        bool attemptingToStart = !currentUserTask.IsStart;

        if (attemptingToStart)
        {
            var runningTask = userTaskList.Data.FirstOrDefault(x => x.IsStart && x.TaskId != setupTaskDto.Id);

            if (runningTask != null)
            {
                toastRef?.Show($"This Task is Running \"{runningTask.TaskTitle}\". " + "Please Stop this Task First.","error");
                return;
            }

            currentUserTask.IsStart = true;
            TimerService.StartOrResumeTimer(setupTaskDto.Id, GetStoredTimeSpan());
        }
        else
        {
            TimeSpan totalSpentTime = TimerService.StopTimer();

            currentUserTask.IsStart = false;
            currentUserTask.TaskTime = (long)totalSpentTime.TotalSeconds;
        }

        var userTaskDto = new UserTaskDto
        {
            UserId = currentUserTask.UserId,
            TaskId = currentUserTask.TaskId,
            IsStart = currentUserTask.IsStart,
            TaskTime = currentUserTask.TaskTime,
            UserProgress = currentUserTask.UserProgress
        };

        StateHasChanged();

        bool result = await userTaskService.ChangeStatus(userTaskDto);

        if (result)
        {
            await LoadData();
        }
        else
        {
            if (attemptingToStart)
            {
                TimerService.StopTimer();
                currentUserTask.IsStart = false;
            }
            else
            {
                TimerService.StartOrResumeTimer(setupTaskDto.Id, GetStoredTimeSpan());
                currentUserTask.IsStart = true;
            }

            userTaskDto.IsStart = currentUserTask.IsStart;
            userTaskDto.TaskTime = currentUserTask.TaskTime;

            StateHasChanged();

            toastRef?.Show(
                "Pehle chalne wale task ko stop karein ya kuch ghalat ho gaya hai.",
                "error");
        }
    }

    public void Dispose()
    {
        TimerService.OnTick -= () => InvokeAsync(StateHasChanged);
        TimerService.OnStateChange -= () => InvokeAsync(StateHasChanged);
        debounceTimer?.Dispose();
    }

}