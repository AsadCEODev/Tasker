@using TMS.Shared.Model.Setup
<div class="card shadow-sm border rounded-3 overflow-hidden h-100">
    
    <!-- 1. DYNAMIC DARK HEADER (Status/Tag ke hisab se Color Change hoga) -->
    <div class="card-header border-0 px-3 py-2 text-white" style="@GetHeaderStyle(Task.StatusObj?.StatusTitle, Task.TagObj?.TagTitle)">
        <div class="d-flex justify-content-between align-items-center">
            
            <!-- Left: Task Title -->
            <div class="overflow-hidden pe-2">
                <span class="text-uppercase fw-bold opacity-75 d-block" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                    TASK TITLE
                </span>
                <h6 class="fw-bold mb-0 text-truncate text-white" style="font-size: 0.95rem;" title="@Task.TaskTitle">
                    @Task.TaskTitle
                </h6>
            </div>

            <!-- Right: Priority / Tag Badge -->
            @if (Task.TagObj != null && !string.IsNullOrEmpty(Task.TagObj.TagTitle))
            {
                <div class="text-end flex-shrink-0">
                    <span class="text-uppercase fw-bold d-block opacity-75" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                        PRIORITY
                    </span>
                    <span class="badge px-3 py-1 fw-bold @GetBadgeClass(Task.TagObj.TagTitle)" style="font-size: 0.75rem;">
                        @Task.TagObj.TagTitle
                    </span>
                </div>
            }
        </div>
    </div>

    <!-- 2. BODY (Key-Value Details) -->
    <div class="card-body p-3 bg-white" style="font-size: 0.82rem;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary fw-medium">Project:</span>
            <span class="fw-semibold text-dark text-truncate ms-1" style="max-width: 140px;">
                @(Task.SetupProject?.ProjectName ?? "N/A")
            </span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary fw-medium">Status:</span>
            <span class="fw-semibold text-dark">
                @(Task.StatusObj?.StatusTitle ?? "N/A")
            </span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary fw-medium">Created On:</span>
            <span class="fw-semibold text-dark">@Task.CreatedOn.ToString("dd-MM-yyyy")</span>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="text-secondary fw-medium">Description:</span>
            <span class="fw-semibold text-dark text-truncate ms-1" style="max-width: 140px;">
                @(string.IsNullOrEmpty(Task.TaskDesc) ? "N/A" : Task.TaskDesc)
            </span>
        </div>
    </div>

    <!-- 3. LIGHT FOOTER (Assigned To & Due Date) -->
    <div class="card-footer border-top px-3 py-2 bg-light">
        <div class="d-flex justify-content-between align-items-center" style="font-size: 0.75rem;">
            <div>
                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                    ASSIGNED TO
                </span>
                <span class="fw-bold text-dark text-truncate d-inline-block" style="max-width: 110px;">
                    @(Task.UserObj?.UserName ?? "Unassigned")
                </span>
            </div>
            <div class="text-end">
                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                    DUE DATE
                </span>
                <span class="fw-bold text-dark">
                    @Task.DueDate.ToString("dd-MM-yyyy")
                </span>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public SetupTaskDto Task { get; set; } = default!;

    // 1. Header ka Background Color (Status Completed hone par Green, warna Priority ke hisab se)
    private string GetHeaderStyle(string? statusTitle, string? tagTitle)
    {
        // Agar status "Completed" / "Complete" hai to Green Header
        if (!string.IsNullOrEmpty(statusTitle) && statusTitle.ToLower().Contains("complete"))
        {
            return "background-color: #1e7e34;"; // Professional Dark Green
        }

        // Standard Priority Colors
        return tagTitle?.ToLower().Trim() switch
        {
            "high" => "background-color: #bd2130;",    // Dark Red
            "medium" => "background-color: #d97706;",  // Dark Amber / Orange
            "low" => "background-color: #198754;",     // Success Green
            _ => "background-color: #495057;"          // Reference Dark Slate Gray
        };
    }

    // 2. Priority Badge Box ka Background (Orange/Customized)
    private string GetBadgeClass(string? tagTitle) => tagTitle?.ToLower().Trim() switch
    {
        "high" => "bg-danger text-white",
        "medium" => "bg-warning text-dark",  // Darker Amber/Orange Badge
        "low" => "bg-success text-white",
        _ => "bg-light text-dark"
    };
}