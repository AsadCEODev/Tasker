@using TMS.Shared.Model.Setup

<div class="card kanban-card border-0 shadow-sm mb-2">

    <div class="card-body p-3">

        <div class="d-flex justify-content-between align-items-start">

            <h6 class="mb-0 fw-bold text-truncate">
                @Task.TaskTitle
            </h6>

            <div class="dropdown">
                <a href="#" data-bs-toggle="dropdown">
                    <i class="ti ti-dots-vertical"></i>
                </a>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="ti ti-edit me-2"></i>Edit
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item text-danger" href="#">
                            <i class="ti ti-trash me-2"></i>Delete
                        </a>
                    </li>
                </ul>
            </div>

        </div>

        <div class="mt-2">

            <span class="badge @PriorityBadge(Task.TagObj?.TagTitle)">
                @(Task.TagObj?.TagTitle ?? "Low")
            </span>

        </div>

        <p class="text-muted small mt-3 mb-3"
               style="min-height:60px">
            @Task.TaskDesc
        </p>

        <div class="small mb-2">

            <i class="ti ti-folder me-1 text-primary"></i>

            <span class="fw-semibold">
                @(Task.ProjectObj?.ProjectName ?? "-")
            </span>

        </div>

        <div class="small mb-3">

            <span class="badge @StatusBadge(Task.StatusObj?.StatusTitle)">
                @(Task.StatusObj?.StatusTitle ?? "Pending")
            </span>

        </div>

        <hr class="my-2" />

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <i class="ti ti-user-circle text-primary"></i>

                <span class="small ms-1">
                    @(Task.UserObj?.FullName ?? "Unassigned")
                </span>

            </div>

            <div class="text-muted small">

                <i class="ti ti-calendar"></i>

                @Task.DueDate.ToString("dd MMM")

            </div>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public SetupTaskDto Task { get; set; } = new();

    private string PriorityBadge(string? priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "bg-danger",
            "medium" => "bg-warning text-dark",
            "low" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string StatusBadge(string? status)
    {
        return status?.ToLower() switch
        {
            "completed" => "bg-label-success",
            "pending" => "bg-label-warning",
            "in progress" => "bg-label-primary",
            "cancelled" => "bg-label-danger",
            _ => "bg-label-secondary"
        };
    }

}