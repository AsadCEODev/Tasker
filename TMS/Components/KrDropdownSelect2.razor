@using System.Text.Json


@inject IJSRuntime JSRuntime
@implements IDisposable
@typeparam TItem
@typeparam TValue


@if (!AreParametersSet)
{
	<div class="alert alert-danger p-1" role="alert">
		<p>
			<strong>Component: KrDropdownSelect2  Misconfiguration!</strong>
		</p>
		<p>
			<strong> Entity Name: @(typeof(TItem).FullName)</strong>
		</p>
		<p> TextSelector  and ValueSelector  parameters are required.</p>
	</div>
}


@if (ErrorMessage != string.Empty)
{
	<div class="alert alert-danger" role="alert">
		<strong>Error: @ErrorMessage</strong>
	</div>
}


@if (Data == null)
{
	<p>Loading....</p>
}
else
{
	@if (AreParametersSet)
	{
		if (IsMultiSelect)
		{
			<select id="@ElementId" class="form-control" @attributes="AdditionalAttributes" multiple>
				<option value="">  ----  Select  ---   </option>
				@foreach (var item in Data)
				{
					// Adjust this based on your data structure
					<option value="@ValueSelector(item)">@TextSelector(item)</option>
				}
			</select>
		}
		else
		{

			<select id="@ElementId" class="form-control" @attributes="AdditionalAttributes">
				<option value="">  ----  Select  ---   </option>
				@foreach (var item in Data)
				{
					// Adjust this based on your data structure
					<option value="@ValueSelector(item)">@TextSelector(item)</option>
				}
			</select>
		}
	}
	else
	{

	}

}



@code {
	private bool AreParametersSet => (TextSelector != null && ValueSelector != null && TextSelector != default! && ValueSelector != default!);


	// Parameter to hold the data list
	[Parameter, EditorRequired]
	public IEnumerable<TItem> Data { get; set; } = default!;

	// 2. Use TValue for the binding parameters
	[Parameter]
	public TValue? Value { get; set; }

	[Parameter]
	public EventCallback<TValue?> ValueChanged { get; set; }

	// Parameters for selecting the text and value properties from the TItem
	[Parameter, EditorRequired]
	public Func<TItem, string> TextSelector { get; set; } = default!;

	[Parameter, EditorRequired]
	public Func<TItem, string> ValueSelector { get; set; } = default!;

	// Optional: Pass through other HTML attributes like data-placeholder
	[Parameter(CaptureUnmatchedValues = true)]
	public Dictionary<string, object> AdditionalAttributes { get; set; } = new();
	// Unique ID for the select element
	private string ElementId = $"select2-{Guid.NewGuid().ToString("N")}";
	private DotNetObjectReference<KrDropdownSelect2<TItem, TValue>>? DotNetRef;

	// 3. Determine if it's multi-select by checking the TValue type
	//private bool IsMultiSelect => typeof(TValue) == typeof(List<string>) || typeof(TValue) == typeof(string[]);
	private bool IsMultiSelect =>
		// 1. Check if it's an array (e.g., MyModel[])
		typeof(TValue).IsArray ||

		// 2. Check if it's a Generic List (e.g., List<MyModel> or List<string>)
		(typeof(TValue).IsGenericType &&
		 typeof(TValue).GetGenericTypeDefinition() == typeof(List<>)) ||

		// 3. Optional: Check for other collection types like IEnumerable<T> or ICollection<T>
		(typeof(TValue).IsGenericType &&
		 (typeof(TValue).GetGenericTypeDefinition() == typeof(IEnumerable<>) ||
			typeof(TValue).GetGenericTypeDefinition() == typeof(ICollection<>)));
	// 1. Store the previous value to avoid unnecessary re-calls to JavaScript.
	private TValue? PreviousValue;
	private int PreviousDataHashCode;
	private bool ValueSetFromCode = false;

	private string ErrorMessage = string.Empty;


	private object? GetIdFromValue(TValue? value)
	{
		if (value == null) return null;

		if (IsMultiSelect)
		{
			// اگر Value ایک لسٹ ہے (List<ClassModel>)
			var items = value as IEnumerable<TItem>;
			if (items != null)
			{
				// تمام اشیاء کی IDs نکال کر Array بنا دیں
				return items.Select(x => ValueSelector(x)).ToArray();
			}
		}
		else
		{
			// اگر Value ایک اکیلا آبجیکٹ ہے (ClassModel)
			return ValueSelector((TItem)(object)value);
		}

		return null;
	}

	// 1. Initialize Select2 after the component is rendered
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		try
		{
			if (firstRender && AreParametersSet && Data != null)
			{
				DotNetRef = DotNetObjectReference.Create(this);
				await JSRuntime.InvokeVoidAsync("Select2_Helper.initialize", ElementId, DotNetRef);

				if (Value is not null)
				{
					// یہاں بھی وہی ہیلپر استعمال کریں
					var initialIds = GetIdFromValue(Value);
					await JSRuntime.InvokeVoidAsync("Select2_Helper.setValue", ElementId, initialIds);
				}

				PreviousValue = Value;
			}

		}
		catch (Exception ex)
		{

			ErrorMessage = $"Error initializing Select2: {ex.Message}";
		}

	}

	// 2. Add OnParametersSetAsync to handle external changes to the 'Value' property.
	protected override async Task OnParametersSetAsync()
	{



		// 🟢 CRITICAL FIX: Check if we are running interactively on the client.
		// If JSRuntime can be cast to IJSInProcessRuntime, we are on the server (prerendering).
		// If JSRuntime is available, we are in the browser (interactive).

		// This check ensures the code block runs only in the browser:
		if (JSRuntime is IJSInProcessRuntime)
		{
			// We are on the server (prerendering), DO NOT call JS.
			// We still run the data/value tracking logic:
			PreviousValue = Value;
			PreviousDataHashCode = Data?.GetHashCode() ?? 0;
			return;
		}

		if (JSRuntime is IJSInProcessRuntime || !AreParametersSet) return;

		// چیک کریں کہ کیا واقعی ویلیو تبدیل ہوئی ہے (تاکہ بلاوجہ JS کال نہ ہو)
		bool hasChanged = !EqualityComparer<TValue>.Default.Equals(Value, PreviousValue);

		if (hasChanged && !ValueSetFromCode)
		{
			// Value میں سے صرف ID یا IDs نکالیں
			var idsToSend = GetIdFromValue(Value);

			// JS کو صرف IDs بھیجیں
			await JSRuntime.InvokeVoidAsync("Select2_Helper.setValue", ElementId, idsToSend);
		}

		PreviousValue = Value;
		ValueSetFromCode = false; // فلیگ ری سیٹ کریں

	}


	// 2. C# method invoked from JavaScript when Select2 changes
	// Inside KrDropdownSelect2.razor component


	[JSInvokable]
	public async Task OnSelect2Change(JsonElement selectedValue)
	{
		try
		{
			TValue? newValue = default;

			if (IsMultiSelect)
			{
				// 1. JS سے آنے والی IDs کو نکالیں
				List<string> selectedIds = new();
				if (selectedValue.ValueKind == JsonValueKind.Array)
				{
					selectedIds = selectedValue.EnumerateArray()
																		 .Select(x => x.GetString() ?? "")
																		 .Where(x => !string.IsNullOrEmpty(x))
																		 .ToList();
				}

				// 2. ان IDs کی بنیاد پر Data لسٹ سے اصل آبجیکٹس (TItem) نکالیں
				var selectedItems = Data.Where(item =>
						selectedIds.Contains(ValueSelector(item)))
						.ToList();

				// 3. اسے TValue (List<TItem>) میں تبدیل کریں
				// ہم اسے پہلے object میں کاسٹ کرتے ہیں تاکہ کمپائلر اعتراض نہ کرے
				newValue = (TValue)(object)selectedItems;
			}
			else
			{
				// Single Select کے لیے logic
				string? id = selectedValue.ValueKind == JsonValueKind.String
										 ? selectedValue.GetString()
										 : null;

				if (!string.IsNullOrEmpty(id))
				{
					var selectedItem = Data.FirstOrDefault(item => ValueSelector(item) == id);
					newValue = (TValue?)(object?)selectedItem;
				}
			}

			// --- انفینٹی لوپ سے بچاؤ اور اپ ڈیٹ ---

			// اگر نئی ویلیو پرانی ویلیو جیسی ہی ہے تو دوبارہ پروسیس نہ کریں
			if (EqualityComparer<TValue>.Default.Equals(newValue, Value)) return;

			// فلیگ سیٹ کریں تاکہ OnParametersSet دوبارہ JS کو کال نہ کرے
			ValueSetFromCode = true;

			Value = newValue;
			PreviousValue = Value; // ٹریکر کو اپ ڈیٹ کریں

			// پیرنٹ کمپوننٹ کو اطلاع دیں
			await ValueChanged.InvokeAsync(Value);
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Error updating selection: {ex.Message}";
			StateHasChanged();
		}
	}



	// 4. Dispose the component and the Select2 instance
	public async void Dispose()
	{
		try
		{
			// DotNetRef کو یہاں ڈسپوز کرنا ضروری ہے
			DotNetRef?.Dispose();

			// اسے 'Fire and Forget' کے طور پر چلائیں اور ایرر کو صرف لاگ کریں، دوبارہ تھرو (throw) نہ کریں
			_ = JSRuntime.InvokeVoidAsync("Select2_Helper.dispose", ElementId);
		}
		catch (Exception ex)
		{
			// یہاں 'throw' نہ کریں، ورنہ سرکٹ ٹرمینٹ ہو جائے گا
			Console.WriteLine($"Select2 Dispose Error: {ex.Message}");
		}
		//DotNetRef?.Dispose();
	}
}