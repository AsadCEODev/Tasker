<style>
    /* Global screen context fix for Modal Overlays */
    .custom-toast-wrapper {
        position: fixed !important;
        top: 25px !important;
        right: 25px !important;
        z-index: 999999 !important; /* Modal (1050/1055) se kafi high */
        pointer-events: auto;
    }

    .toast-animate {
        animation: slideInRight 0.3s ease-out forwards;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .custom-toast-success {
        background-color: #28a745;
        color: white;
    }

    .custom-toast-error {
        background-color: #dc3545;
        color: white;
    }
</style>

@if (IsVisible)
{
    <div class="custom-toast-wrapper toast-animate">
        <div class="toast show align-items-center border-0 @(Type == "success" ? "custom-toast-success" : "custom-toast-error")"
             style="min-width: 300px; box-shadow: 0 8px 16px rgba(0,0,0,0.3);" role="alert">
            <div class="d-flex align-items-center">
                <div class="toast-body flex-grow-1" style="font-weight: 500;">
                    @Message
                </div>
                <button type="button" class="btn-close btn-close-white me-2" @onclick="Hide"></button>
            </div>
        </div>
    </div>
}

@code {
    public bool IsVisible { get; set; }
    public string Message { get; set; } = "";
    public string Type { get; set; } = "success";

    private CancellationTokenSource? _cts;

    public async void Show(string message, string type = "success")
    {
        // Cancel existing timer if toast is triggered again quickly
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        Message = message;
        Type = type;
        IsVisible = true;
        StateHasChanged();

        try
        {
            // Proper Async Auto-Hide Logic
            await Task.Delay(3000, _cts.Token);
            IsVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Ignore timer cancel when new toast triggers
        }
    }

    public void Hide()
    {
        IsVisible = false;
        _cts?.Cancel();
        StateHasChanged();
    }
}